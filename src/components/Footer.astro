---
---
<footer class="bg-muted/30 border-t mt-auto">
  <div class="container mx-auto px-4 max-w-screen-xl py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 md:gap-8">
      
      <!-- Kolom 1: Identitas Desa -->
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="inline-block">
          <img src="/logodesa.webp" alt="Logo Desa Puspamukti" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-auto object-contain drop-shadow-xs" />
        </a>
        <p class="text-muted-foreground text-sm leading-relaxed pr-0 lg:pr-6">
          Portal web resmi Pemerintah Desa Puspamukti, Kecamatan Cigalontang, Kabupaten Tasikmalaya. Mewujudkan desa mandiri, transparan, dan berdaya saing melalui digitalisasi pelayanan publik.
        </p>
        <div class="pt-1">
          <a href="/warga/login" class="inline-flex items-center gap-2 text-xs font-bold text-primary hover:underline">
            <span>Masuk ke Portal Warga</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Kolom 2: Profil & Layanan -->
      <div class="lg:col-span-2">
        <h3 class="font-bold text-foreground text-sm uppercase tracking-wider mb-4">Profil & Layanan</h3>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="/profil" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Profil Desa</a></li>
          <li><a href="/profil/data-statistik" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Data Statistik</a></li>
          <li><a href="/profil/desa-wisata" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Desa Wisata</a></li>
          <li><a href="/pemerintahan" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Pemerintahan</a></li>
          <li><a href="/layanan" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Layanan Publik</a></li>
        </ul>
      </div>

      <!-- Kolom 3: Informasi & Transparansi -->
      <div class="lg:col-span-2">
        <h3 class="font-bold text-foreground text-sm uppercase tracking-wider mb-4">Informasi Publik</h3>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="/transparansi" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Transparansi APBDes</a></li>
          <li><a href="/informasi/media" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Berita Desa</a></li>
          <li><a href="/informasi/peta" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Peta Wilayah</a></li>
          <li><a href="/informasi/bencana" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Siaga Bencana</a></li>
          <li><a href="/regulasi" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Regulasi Desa</a></li>
          <li><a href="/bumdes" class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span> Katalog BUMDes</a></li>
        </ul>
      </div>

      <!-- Kolom 4: Kontak & Jam Operasional -->
      <div class="lg:col-span-4">
        <h3 class="font-bold text-foreground text-sm uppercase tracking-wider mb-4">Hubungi Kami</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li class="flex items-start gap-3">
            <div class="mt-0.5 bg-primary/10 p-1.5 rounded-lg text-primary shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <span class="leading-relaxed text-xs sm:text-sm">Kantor Kepala Desa Puspamukti, Kec. Cigalontang, Kab. Tasikmalaya, Jawa Barat</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="bg-primary/10 p-1.5 rounded-lg text-primary shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <span class="text-xs sm:text-sm">puspamuktidesa@gmail.com</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="bg-primary/10 p-1.5 rounded-lg text-primary shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <span class="text-xs sm:text-sm">Senin - Jumat (08:00 - 15:00 WIB)</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
  
  <!-- Copyright Bar -->
  <div class="border-t bg-background">
    <div class="container mx-auto px-4 max-w-screen-xl py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-muted-foreground text-center md:text-left">
        &copy; {new Date().getFullYear()} Pemerintah Desa Puspamukti. Hak Cipta Dilindungi.
      </p>
      <p class="text-xs text-muted-foreground font-medium text-center md:text-right">
        Dikembangkan oleh <a href="/tim-kkn" class="text-primary font-bold hover:underline">Tim KKN Desa Puspamukti</a>
      </p>
    </div>
  </div>
</footer>
