---
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---
<nav class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur-md supports-[backdrop-filter]:bg-background/80 shadow-2xs">
  <div class="container mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center mr-6 group shrink-0">
      <img src="/logodesa.webp" alt="Logo Desa Puspamukti" width="40" height="40" class="h-10 w-auto object-contain drop-shadow-xs transition-transform group-hover:scale-105" />
    </a>
    
    <div class="hidden lg:flex flex-1 items-center justify-start space-x-5 text-sm font-medium">
      <a href="/" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/') ? 'text-primary font-bold' : 'text-foreground/70'}`}>Beranda</a>
      
      <!-- Profil Dropdown -->
      <div class="relative group py-4">
        <a href="/profil" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary flex items-center gap-1 ${isActive('/profil') ? 'text-primary font-bold' : 'text-foreground/70'}`}>
          Profil Desa
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 group-hover:rotate-180 transition-transform duration-200"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="absolute top-full left-0 w-52 rounded-2xl border bg-popover text-popover-foreground shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all -translate-y-2 group-hover:translate-y-0 p-1.5 z-50">
          <div class="flex flex-col space-y-0.5">
            <a href="/profil" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/profil' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Profil & Sejarah</a>
            <a href="/profil/data-statistik" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/profil/data-statistik' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Data Statistik Desa</a>
            <a href="/profil/desa-wisata" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/profil/desa-wisata' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Potensi Desa Wisata</a>
            <a href="/transparansi" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/transparansi' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Transparansi APBDes</a>
          </div>
        </div>
      </div>
      
      <a href="/pemerintahan" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/pemerintahan') ? 'text-primary font-bold' : 'text-foreground/70'}`}>Pemerintahan</a>
      
      <!-- Informasi Dropdown -->
      <div class="relative group py-4">
        <a href="/informasi" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary flex items-center gap-1 ${isActive('/informasi') ? 'text-primary font-bold' : 'text-foreground/70'}`}>
          Pusat Informasi
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 group-hover:rotate-180 transition-transform duration-200"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="absolute top-full left-0 w-56 rounded-2xl border bg-popover text-popover-foreground shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all -translate-y-2 group-hover:translate-y-0 p-1.5 z-50">
          <div class="flex flex-col space-y-0.5">
            <a href="/informasi/media" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/informasi/media' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Kabar & Berita Desa</a>
            <a href="/informasi/peta" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/informasi/peta' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Peta Interaktif Wilayah</a>
            <a href="/informasi/bencana" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/informasi/bencana' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Mitigasi & Siaga Bencana</a>
            <a href="/informasi/zona-khusus" class={`px-3 py-2 rounded-xl text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors ${pathname === '/informasi/zona-khusus' ? 'bg-accent/70 text-primary font-bold' : ''}`}>Zona Wilayah Khusus</a>
          </div>
        </div>
      </div>

      <a href="/regulasi" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/regulasi') ? 'text-primary font-bold' : 'text-foreground/70'}`}>Regulasi</a>
      <a href="/bumdes" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/bumdes') ? 'text-primary font-bold' : 'text-foreground/70'}`}>BUMDes</a>
      <a href="/layanan" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/layanan') ? 'text-primary font-bold' : 'text-foreground/70'}`}>Layanan</a>
      <a href="/kontak" class={`px-2.5 py-1.5 rounded-lg transition-colors hover:text-primary ${isActive('/kontak') ? 'text-primary font-bold' : 'text-foreground/70'}`}>Kontak</a>
    </div>
    
    <div class="flex items-center space-x-2 sm:space-x-3">
      <!-- Searchbar Form -->
      <form action="/informasi/media" method="GET" class="relative hidden xl:flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input 
          type="search" 
          name="q"
          placeholder="Cari berita desa..." 
          class="flex h-9 w-36 lg:w-48 rounded-xl border border-input bg-background/60 pl-8.5 pr-3 text-xs shadow-2xs transition-all placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:w-56"
        />
      </form>

      <!-- Dynamic Auth Buttons Container -->
      <div id="nav-auth-box" class="flex items-center gap-1.5">
        
        <!-- State A: Warga Logged In -->
        <div id="nav-state-warga" class="hidden items-center gap-1.5">
          <a href="/warga" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-primary/10 text-primary text-xs font-bold border border-primary/20 hover:bg-primary/20 transition-colors shadow-2xs">
            <span>👤</span>
            <span id="nav-warga-name" class="truncate max-w-[110px]">Portal Warga</span>
          </a>
          <button id="nav-warga-logout-btn" class="p-2 rounded-xl text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" title="Keluar dari Portal Warga">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x1="9" y1="12" y2="12"/></svg>
          </button>
        </div>

        <!-- State B: Admin Logged In -->
        <div id="nav-state-admin" class="hidden items-center gap-1.5">
          <a href="/admin" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-500/10 text-purple-700 text-xs font-bold border border-purple-300 hover:bg-purple-500/20 transition-colors shadow-2xs">
            <span>⚙️</span>
            <span>Panel Admin</span>
          </a>
          <button id="nav-admin-logout-btn" class="p-2 rounded-xl text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" title="Keluar dari Panel Admin">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x1="9" y1="12" y2="12"/></svg>
          </button>
        </div>

        <!-- State C: Guest / Not Logged In -->
        <div id="nav-state-guest" class="flex items-center gap-2">
          <a href="/warga/login" class="inline-flex items-center justify-center rounded-xl text-xs font-bold transition-all bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-3.5 shadow-xs hover:shadow-md gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Portal Warga</span>
          </a>

          <a href="/admin/login" class="hidden sm:inline-flex items-center justify-center rounded-xl text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-9 w-9 border border-input bg-background" title="Masuk ke Panel Admin">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x1="3" y1="12" y2="12"/></svg>
          </a>
        </div>

      </div>
      
      <!-- Mobile menu trigger -->
      <button id="mobile-menu-btn" class="lg:hidden inline-flex items-center justify-center rounded-xl p-2 text-foreground/70 hover:bg-accent hover:text-accent-foreground cursor-pointer" aria-label="Buka Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Content -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border/40 bg-background/98 backdrop-blur-md px-4 py-5 space-y-4 max-h-[85vh] overflow-y-auto">
    <!-- Search Bar on Mobile -->
    <form action="/informasi/media" method="GET" class="relative flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input 
        type="search" 
        name="q"
        placeholder="Cari berita atau informasi desa..." 
        class="flex h-10 w-full rounded-xl border border-input bg-background/80 pl-9 pr-3 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary shadow-2xs"
      />
    </form>

    <div class="space-y-1">
      <a href="/" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>Beranda</a>
      
      <!-- Mobile Profil Section -->
      <div class="pt-2">
        <div class="px-3 text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Profil Desa</div>
        <div class="mt-1 space-y-1 pl-2 border-l border-border/60 ml-3">
          <a href="/profil" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/profil' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Profil & Sejarah</a>
          <a href="/profil/data-statistik" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/profil/data-statistik' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Data & Statistik</a>
          <a href="/profil/desa-wisata" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/profil/desa-wisata' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Potensi Desa Wisata</a>
          <a href="/transparansi" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/transparansi' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Transparansi APBDes</a>
        </div>
      </div>

      <a href="/pemerintahan" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/pemerintahan') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>Pemerintahan</a>

      <!-- Mobile Informasi Section -->
      <div class="pt-2">
        <div class="px-3 text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Pusat Informasi</div>
        <div class="mt-1 space-y-1 pl-2 border-l border-border/60 ml-3">
          <a href="/informasi/media" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/informasi/media' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Kabar & Berita</a>
          <a href="/informasi/peta" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/informasi/peta' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Peta Wilayah</a>
          <a href="/informasi/bencana" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/informasi/bencana' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Siaga Bencana</a>
          <a href="/informasi/zona-khusus" class={`block px-3 py-1.5 rounded-lg text-xs font-medium hover:text-primary ${pathname === '/informasi/zona-khusus' ? 'text-primary font-bold' : 'text-foreground/70'}`}>Zona Wilayah Khusus</a>
        </div>
      </div>

      <a href="/regulasi" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/regulasi') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>Regulasi Desa</a>
      <a href="/bumdes" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/bumdes') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>BUMDes</a>
      <a href="/layanan" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/layanan') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>Layanan Publik</a>
      <a href="/kontak" class={`block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-accent transition-colors ${isActive('/kontak') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground/80'}`}>Kontak & Pengaduan</a>
    </div>

    <!-- Mobile Action Buttons -->
    <div class="pt-4 border-t border-border/40 grid grid-cols-2 gap-3" id="mobile-nav-actions">
      <a href="/warga/login" class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground h-11 px-4 text-xs font-bold hover:bg-primary/90 shadow-xs gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Portal Warga
      </a>
      <a href="/admin/login" class="inline-flex items-center justify-center rounded-xl border border-input bg-card text-foreground h-11 px-4 text-xs font-bold hover:bg-accent gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x1="3" y1="12" y2="12"/></svg>
        Admin Desa
      </a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }

    // Dynamic Navigation Auth State
    const wargaSessionStr = localStorage.getItem('warga_session');
    const adminSessionStr = localStorage.getItem('admin_session');

    const stateGuest = document.getElementById('nav-state-guest');
    const stateWarga = document.getElementById('nav-state-warga');
    const stateAdmin = document.getElementById('nav-state-admin');
    const wargaName = document.getElementById('nav-warga-name');

    if (wargaSessionStr) {
      try {
        const user = JSON.parse(wargaSessionStr);
        stateGuest?.classList.add('hidden');
        stateGuest?.classList.remove('flex');

        stateWarga?.classList.remove('hidden');
        stateWarga?.classList.add('flex');

        if (wargaName) {
          wargaName.textContent = user.nama ? user.nama.split(' ')[0] : 'Warga';
        }
      } catch {}
    } else if (adminSessionStr) {
      stateGuest?.classList.add('hidden');
      stateGuest?.classList.remove('flex');

      stateAdmin?.classList.remove('hidden');
      stateAdmin?.classList.add('flex');
    }

    // Logout Warga Click Handler
    document.getElementById('nav-warga-logout-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (confirm('Apakah Anda yakin ingin keluar dari Portal Warga?')) {
        localStorage.removeItem('warga_session');
        window.location.href = '/warga/login';
      }
    });

    // Logout Admin Click Handler (Complete Purge of all Admin tokens)
    document.getElementById('nav-admin-logout-btn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (confirm('Apakah Anda yakin ingin keluar dari Panel Admin?')) {
        localStorage.removeItem('admin_session');
        for (let i = localStorage.length - 1; i >= 0; i--) {
          const k = localStorage.key(i);
          if (k && (k.indexOf('auth-token') !== -1 || k.indexOf('supabase') !== -1)) {
            localStorage.removeItem(k);
          }
        }
        try {
          const { supabase } = await import('../lib/supabase');
          await supabase.auth.signOut();
        } catch {}
        window.location.href = '/admin/login';
      }
    });
  });
</script>
