---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

// Fetch all news from Supabase
const { data: dbBerita } = await supabase
  .from('berita')
  .select('*')
  .order('created_at', { ascending: false });

const beritaList = dbBerita || [];
---

<AdminLayout title="Kelola Berita & Pengumuman">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Berita & Pengumuman</h1>
        <p class="text-muted-foreground mt-1">Tulis dan kelola artikel berita, liputan kegiatan, serta pengumuman resmi desa.</p>
      </div>
      <button 
        id="add-berita-btn"
        class="inline-flex items-center justify-center rounded-xl text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 gap-2 shadow-md cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Tulis Berita Baru
      </button>
    </div>

    <!-- Table Container -->
    <div class="bg-card border rounded-3xl shadow-sm overflow-hidden animate-fade-in">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-muted/50 text-muted-foreground font-semibold border-b">
            <tr>
              <th class="px-6 py-4">Foto</th>
              <th class="px-6 py-4">Judul Berita</th>
              <th class="px-6 py-4">Kategori</th>
              <th class="px-6 py-4">Tanggal Publikasi</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y" id="berita-table-body">
            {beritaList.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-muted-foreground">
                  Belum ada berita atau pengumuman yang diterbitkan. Silakan tulis berita baru.
                </td>
              </tr>
            ) : (
              beritaList.map((item) => (
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="px-6 py-4">
                    <div class="w-12 h-9 rounded bg-muted overflow-hidden flex items-center justify-center border">
                      {item.gambar_url ? (
                        <img src={item.gambar_url} alt={item.judul} class="w-full h-full object-cover" />
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-4 font-bold text-foreground max-w-xs sm:max-w-md truncate">
                    {item.judul}
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center rounded-md bg-secondary text-secondary-foreground px-2.5 py-0.5 text-xs font-semibold">
                      {item.kategori}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-muted-foreground">{item.tanggal}</td>
                  <td class="px-6 py-4">
                    <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                      item.status === 'Terbit' ? 'bg-green-500/10 text-green-600' : 'bg-amber-500/10 text-amber-600'
                    }`}>
                      {item.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right whitespace-nowrap">
                    <button 
                      class="edit-berita-btn text-primary hover:underline text-xs font-bold mr-3 cursor-pointer"
                      data-id={item.id}
                      data-judul={item.judul}
                      data-kategori={item.kategori}
                      data-tanggal={item.tanggal}
                      data-status={item.status}
                      data-isi={item.isi}
                      data-gambar_url={item.gambar_url || ''}
                    >
                      Edit
                    </button>
                    <button 
                      class="delete-berita-btn text-destructive hover:underline text-xs font-bold cursor-pointer"
                      data-id={item.id}
                      data-judul={item.judul}
                    >
                      Hapus
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Form -->
  <div id="berita-modal" class="fixed inset-0 bg-background/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-card border w-full max-w-2xl rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
      <div class="px-6 py-5 border-b flex justify-between items-center bg-muted/20">
        <h3 id="modal-title" class="font-bold text-lg text-foreground font-sans">Tulis Berita Baru</h3>
        <button id="close-modal-btn" class="p-1.5 rounded-lg hover:bg-muted text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="berita-form" class="p-6 space-y-4 overflow-y-auto flex-1" novalidate>
        <input type="hidden" id="berita-id" />
        <input type="hidden" id="berita-gambar-existing" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5 md:col-span-2 text-left">
            <label for="berita-judul" class="text-xs font-bold text-foreground uppercase tracking-wider">Judul Berita / Pengumuman</label>
            <input 
              type="text" 
              id="berita-judul" 
              placeholder="Contoh: Kegiatan Kerja Bakti Dusun Cipicung" 
              class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-2xs transition-colors" 
              required
            />
            <p id="berita-judul-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <span>Judul berita wajib diisi (minimal 5 huruf).</span>
            </p>
          </div>

          <div class="space-y-1.5 text-left">
            <label for="berita-kategori" class="text-xs font-bold text-foreground uppercase tracking-wider">Kategori</label>
            <select 
              id="berita-kategori" 
              class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shadow-2xs transition-colors"
              required
            >
              <option value="" disabled selected>-- Pilih Kategori --</option>
              <option value="Kegiatan">Kegiatan</option>
              <option value="Pembangunan">Pembangunan</option>
              <option value="Pengumuman">Pengumuman</option>
              <option value="Opini Warga">Opini Warga</option>
            </select>
            <p id="berita-kategori-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <span>Pilih salah satu kategori berita.</span>
            </p>
          </div>

          <div class="space-y-1.5 text-left">
            <label class="text-xs font-bold text-foreground uppercase tracking-wider">Tanggal Publikasi</label>
            <div class="grid grid-cols-3 gap-2">
              <select id="berita-tanggal-hari" class="flex h-11 w-full rounded-xl border border-input bg-background px-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer" required>
                <option value="" disabled selected>Hari</option>
                {Array.from({ length: 31 }, (_, i) => (
                  <option value={i + 1}>{i + 1}</option>
                ))}
              </select>
              <select id="berita-tanggal-bulan" class="flex h-11 w-full rounded-xl border border-input bg-background px-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer" required>
                <option value="" disabled selected>Bulan</option>
                {['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'].map(month => (
                  <option value={month}>{month}</option>
                ))}
              </select>
              <select id="berita-tanggal-tahun" class="flex h-11 w-full rounded-xl border border-input bg-background px-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer" required>
                <option value="" disabled selected>Tahun</option>
                {Array.from({ length: 10 }, (_, i) => new Date().getFullYear() - 2 + i).map(year => (
                  <option value={year}>{year}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="space-y-1.5 text-left">
            <label for="berita-status" class="text-xs font-bold text-foreground uppercase tracking-wider">Status Publikasi</label>
            <select 
              id="berita-status" 
              class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shadow-2xs transition-colors"
              required
            >
              <option value="" disabled selected>-- Pilih Status --</option>
              <option value="Terbit">Terbit (Publik)</option>
              <option value="Draft">Draft (Arsip)</option>
            </select>
            <p id="berita-status-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <span>Pilih status publikasi.</span>
            </p>
          </div>

          <div class="space-y-1.5 text-left">
            <label for="berita-gambar-file" class="text-xs font-bold text-foreground uppercase tracking-wider">Gambar Sampul Berita</label>
            <div class="flex items-center gap-4">
              <div class="w-16 h-12 bg-muted border rounded-xl flex items-center justify-center overflow-hidden shrink-0" id="berita-gambar-preview">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
              <div class="flex flex-col gap-1 w-full">
                <input 
                  type="file" 
                  id="berita-gambar-file" 
                  accept="image/*"
                  class="block w-full text-xs text-muted-foreground file:mr-2 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-[10px] file:font-semibold file:bg-primary file:text-primary-foreground hover:file:bg-primary/90 cursor-pointer"
                />
                <button type="button" id="delete-berita-gambar-btn" class="text-[10px] text-destructive hover:underline font-bold w-fit cursor-pointer">
                  Hapus Foto
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="berita-isi" class="text-xs font-bold text-foreground uppercase tracking-wider">Isi Konten Berita / Informasi</label>
          <textarea 
            id="berita-isi" 
            rows="6" 
            placeholder="Tulis lengkap isi artikel atau informasi pengumuman di sini..."
            class="flex w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary resize-none shadow-2xs transition-colors"
            required
          ></textarea>
          <p id="berita-isi-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Isi berita wajib diisi minimal 15 huruf.</span>
          </p>
        </div>

        <div class="pt-4 border-t flex justify-end gap-3">
          <button 
            type="button" 
            id="cancel-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl border border-input bg-background hover:bg-accent text-sm font-bold h-11 px-4 cursor-pointer transition-colors"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="submit-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-bold h-11 px-6 shadow-md hover:shadow-lg cursor-pointer transition-all"
          >
            Simpan Berita
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const BUCKET_NAME = 'desa-media';

  const modal = document.getElementById('berita-modal');
  const modalTitle = document.getElementById('modal-title');
  const form = document.getElementById('berita-form') as HTMLFormElement;
  
  const inputId = document.getElementById('berita-id') as HTMLInputElement;
  const inputJudul = document.getElementById('berita-judul') as HTMLInputElement;
  const selectKategori = document.getElementById('berita-kategori') as HTMLSelectElement;
  const selectDay = document.getElementById('berita-tanggal-hari') as HTMLSelectElement;
  const selectMonth = document.getElementById('berita-tanggal-bulan') as HTMLSelectElement;
  const selectYear = document.getElementById('berita-tanggal-tahun') as HTMLSelectElement;
  const selectStatus = document.getElementById('berita-status') as HTMLSelectElement;
  const inputGambarFile = document.getElementById('berita-gambar-file') as HTMLInputElement;
  const inputGambarUrlExisting = document.getElementById('berita-gambar-existing') as HTMLInputElement;
  const previewGambar = document.getElementById('berita-gambar-preview');
  const textareaIsi = document.getElementById('berita-isi') as HTMLTextAreaElement;
  const deleteGambarBtn = document.getElementById('delete-berita-gambar-btn');

  const addBtn = document.getElementById('add-berita-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const cancelBtn = document.getElementById('cancel-modal-btn');
  const submitBtn = document.getElementById('submit-modal-btn');

  // Preview Photo File Change
  if (inputGambarFile) {
    inputGambarFile.addEventListener('change', () => {
      const file = inputGambarFile.files?.[0];
      if (file && previewGambar) {
        const url = URL.createObjectURL(file);
        previewGambar.innerHTML = `<img src="${url}" class="w-full h-full object-cover rounded-lg" />`;
      }
    });
  }

  // Handle Delete Photo Click
  if (deleteGambarBtn) {
    deleteGambarBtn.addEventListener('click', () => {
      if (inputGambarFile) inputGambarFile.value = "";
      if (inputGambarUrlExisting) inputGambarUrlExisting.value = "";
      if (previewGambar) {
        previewGambar.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;
      }
    });
  }

  // Upload helper to Supabase Storage
  const uploadImage = async (file: File, folder: string): Promise<string> => {
    const ext = file.name.split('.').pop();
    const cleanName = `${folder}/${Date.now()}_${Math.random().toString(36).substring(7)}.${ext}`;

    const { data, error } = await supabase.storage
      .from(BUCKET_NAME)
      .upload(cleanName, file, {
        cacheControl: '3600',
        upsert: false
      });

    if (error) throw error;

    const { data: urlData } = supabase.storage
      .from(BUCKET_NAME)
      .getPublicUrl(cleanName);

    return urlData.publicUrl;
  };

  const openModal = (title: string, id = "", judul = "", kategori = "", tanggal = "", status = "", gambar = "", isi = "") => {
    if (!modal) return;
    if (modalTitle) modalTitle.innerText = title;
    
    inputId.value = id;
    inputJudul.value = judul;
    selectKategori.value = kategori;
    
    if (tanggal) {
      const parts = tanggal.split(' ');
      if (parts.length === 3) {
        selectDay.value = parts[0];
        selectMonth.value = parts[1];
        selectYear.value = parts[2];
      }
    } else {
      const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      const d = new Date();
      selectDay.value = d.getDate().toString();
      selectMonth.value = months[d.getMonth()];
      selectYear.value = d.getFullYear().toString();
    }

    selectStatus.value = status;
    inputGambarUrlExisting.value = gambar;
    textareaIsi.value = isi;

    if (inputGambarFile) inputGambarFile.value = "";

    if (gambar && previewGambar) {
      previewGambar.innerHTML = `<img src="${gambar}" class="w-full h-full object-cover rounded-lg" />`;
    } else if (previewGambar) {
      previewGambar.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  const judulError = document.getElementById('berita-judul-error');
  const kategoriError = document.getElementById('berita-kategori-error');
  const statusError = document.getElementById('berita-status-error');
  const isiError = document.getElementById('berita-isi-error');

  function validateBeritaForm(): boolean {
    let valid = true;

    // Judul
    if (inputJudul.value.trim().length < 5) {
      inputJudul.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputJudul.classList.remove('border-input', 'focus-visible:ring-primary');
      judulError?.classList.remove('hidden');
      valid = false;
    } else {
      inputJudul.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputJudul.classList.add('border-input', 'focus-visible:ring-primary');
      judulError?.classList.add('hidden');
    }

    // Kategori
    if (!selectKategori.value) {
      selectKategori.classList.add('border-destructive', 'focus-visible:ring-destructive');
      selectKategori.classList.remove('border-input', 'focus-visible:ring-primary');
      kategoriError?.classList.remove('hidden');
      valid = false;
    } else {
      selectKategori.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      selectKategori.classList.add('border-input', 'focus-visible:ring-primary');
      kategoriError?.classList.add('hidden');
    }

    // Status
    if (!selectStatus.value) {
      selectStatus.classList.add('border-destructive', 'focus-visible:ring-destructive');
      selectStatus.classList.remove('border-input', 'focus-visible:ring-primary');
      statusError?.classList.remove('hidden');
      valid = false;
    } else {
      selectStatus.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      selectStatus.classList.add('border-input', 'focus-visible:ring-primary');
      statusError?.classList.add('hidden');
    }

    // Isi
    if (textareaIsi.value.trim().length < 15) {
      textareaIsi.classList.add('border-destructive', 'focus-visible:ring-destructive');
      textareaIsi.classList.remove('border-input', 'focus-visible:ring-primary');
      isiError?.classList.remove('hidden');
      valid = false;
    } else {
      textareaIsi.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      textareaIsi.classList.add('border-input', 'focus-visible:ring-primary');
      isiError?.classList.add('hidden');
    }

    return valid;
  }

  inputJudul?.addEventListener('input', () => { if (!judulError?.classList.contains('hidden')) validateBeritaForm(); });
  selectKategori?.addEventListener('change', () => { if (!kategoriError?.classList.contains('hidden')) validateBeritaForm(); });
  selectStatus?.addEventListener('change', () => { if (!statusError?.classList.contains('hidden')) validateBeritaForm(); });
  textareaIsi?.addEventListener('input', () => { if (!isiError?.classList.contains('hidden')) validateBeritaForm(); });

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove('flex');
    modal.classList.add('hidden');
    form.reset();
    judulError?.classList.add('hidden');
    kategoriError?.classList.add('hidden');
    statusError?.classList.add('hidden');
    isiError?.classList.add('hidden');
  };

  if (addBtn) addBtn.addEventListener('click', () => openModal("Tulis Berita Baru"));
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateBeritaForm()) return;
      
      const id = inputId.value;
      const fileGambar = inputGambarFile.files?.[0];

      if (submitBtn) {
        submitBtn.innerText = "Menyimpan...";
        submitBtn.setAttribute('disabled', 'true');
      }

      try {
        let gambar_url = inputGambarUrlExisting.value || null;

        if (fileGambar) {
          submitBtn.innerText = "Mengunggah Gambar...";
          gambar_url = await uploadImage(fileGambar, 'berita');
        }

        const payload = {
          judul: inputJudul.value.trim(),
          kategori: selectKategori.value,
          tanggal: `${selectDay.value} ${selectMonth.value} ${selectYear.value}`,
          status: selectStatus.value,
          isi: textareaIsi.value.trim(),
          gambar_url
        };

        if (id) {
          const { error } = await supabase
            .from('berita')
            .update(payload)
            .eq('id', parseInt(id));

          if (error) throw error;
        } else {
          const { error } = await supabase
            .from('berita')
            .insert([payload]);

          if (error) throw error;
        }
        window.location.reload();
      } catch (err: any) {
        alert("Gagal menyimpan berita: " + err.message);
      } finally {
        if (submitBtn) {
          submitBtn.innerText = "Simpan Berita";
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }

  // Row actions (Direct bindings without DOMContentLoaded to avoid lifecycle issues)
  const editBtns = document.querySelectorAll('.edit-berita-btn');
  editBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      const id = el.getAttribute('data-id') || "";
      const judul = el.getAttribute('data-judul') || "";
      const kategori = el.getAttribute('data-kategori') || "";
      const tanggal = el.getAttribute('data-tanggal') || "";
      const status = el.getAttribute('data-status') || "";
      const gambar = el.getAttribute('data-gambar_url') || "";
      const isi = el.getAttribute('data-isi') || "";

      openModal("Edit Berita / Pengumuman", id, judul, kategori, tanggal, status, gambar, isi);
    });
  });

  const deleteBtns = document.querySelectorAll('.delete-berita-btn');
  deleteBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      const id = el.getAttribute('data-id');
      const judul = el.getAttribute('data-judul');
      if (!id) return;

      if (confirm(`Apakah Anda yakin ingin menghapus berita "${judul}"?`)) {
        const { error } = await supabase
          .from('berita')
          .delete()
          .eq('id', parseInt(id));

        if (error) {
          alert("Gagal menghapus berita: " + error.message);
        } else {
          alert("Berita berhasil dihapus!");
          window.location.reload();
        }
      }
    });
  });
</script>
