---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Akses Administrator">
  <div class="space-y-6 max-w-5xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Akses Administrator</h1>
        <p class="text-muted-foreground mt-1">Kelola profil akun admin aktif, perbarui kata sandi, dan panduan manajemen hak akses desa.</p>
      </div>
    </div>

    <!-- Active Admin Profile Card -->
    <div class="bg-card border rounded-3xl p-6 sm:p-8 shadow-xs relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-2xl uppercase border border-primary/20 shadow-xs" id="profile-avatar">
            A
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-xl font-bold text-foreground" id="profile-name">Memuat Profil...</h2>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-green-500/10 text-green-600 border border-green-500/20">
                Akun Aktif
              </span>
            </div>
            <p class="text-sm text-muted-foreground font-mono mt-0.5" id="profile-email">puspamuktidesa@gmail.com</p>
            <p class="text-xs text-muted-foreground mt-1">Role: <span class="font-semibold text-foreground">Administrator Desa (Supabase Auth)</span></p>
          </div>
        </div>
      </div>

      <!-- Update Profile & Password Form -->
      <form id="update-profile-form" class="pt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-foreground uppercase tracking-wider">Perbarui Nama Tampilan</h3>
          
          <div class="space-y-1.5">
            <label for="display-name" class="text-xs font-semibold text-muted-foreground">Nama Lengkap / Jabatan</label>
            <input 
              type="text" 
              id="display-name" 
              placeholder="Contoh: Sekretaris Desa Puspamukti"
              class="flex h-11 w-full rounded-xl border border-input bg-background px-3.5 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary shadow-xs"
            />
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm font-bold text-foreground uppercase tracking-wider">Ganti Kata Sandi</h3>
          
          <div class="space-y-1.5">
            <label for="new-password" class="text-xs font-semibold text-muted-foreground">Kata Sandi Baru</label>
            <input 
              type="password" 
              id="new-password" 
              placeholder="Minimal 6 karakter"
              minlength="6"
              class="flex h-11 w-full rounded-xl border border-input bg-background px-3.5 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary shadow-xs"
            />
          </div>
        </div>

        <div class="col-span-1 md:col-span-2 pt-2 flex justify-end">
          <button 
            type="submit" 
            id="save-profile-btn"
            class="inline-flex items-center justify-center rounded-xl text-sm font-bold transition-all bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-6 shadow-xs hover:shadow-md cursor-pointer"
          >
            Simpan Perubahan Akun
          </button>
        </div>
      </form>
    </div>

    <!-- Security & Architecture Information Card -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-card border rounded-3xl p-6 shadow-xs space-y-4">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="font-bold text-base text-foreground">Keamanan Autentikasi Cloud</h3>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Portal Admin Desa Puspamukti dilindungi oleh <strong>Supabase Authentication</strong> dengan enkripsi kata sandi standar industri (Bcrypt/Argon2) dan Row-Level Security (RLS) di database.
        </p>
      </div>

      <div class="bg-card border rounded-3xl p-6 shadow-xs space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
        </div>
        <h3 class="font-bold text-base text-foreground">Menambah Administrator Baru</h3>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Untuk menambah pengurus/perangkat desa baru sebagai admin, Anda dapat mendaftarkan email & kata sandi baru secara instan melalui menu <strong>Authentication &gt; Users</strong> di dashboard Supabase.
        </p>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const profileName = document.getElementById('profile-name');
    const profileEmail = document.getElementById('profile-email');
    const profileAvatar = document.getElementById('profile-avatar');
    const displayNameInput = document.getElementById('display-name') as HTMLInputElement;
    const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
    const form = document.getElementById('update-profile-form');
    const saveBtn = document.getElementById('save-profile-btn');

    // 1. Load active user info
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session && session.user) {
      const email = session.user.email || '';
      const name = session.user.user_metadata?.name || email.split('@')[0] || 'Administrator';
      
      if (profileName) profileName.textContent = name;
      if (profileEmail) profileEmail.textContent = email;
      if (profileAvatar) profileAvatar.textContent = name.charAt(0).toUpperCase();
      if (displayNameInput) displayNameInput.value = name;
    }

    // 2. Update Profile Handler
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const newName = displayNameInput?.value?.trim();
      const newPassword = newPasswordInput?.value?.trim();

      if (!newName && !newPassword) {
        alert('Tidak ada perubahan yang dimasukkan.');
        return;
      }

      if (saveBtn) {
        saveBtn.textContent = 'Menyimpan...';
        saveBtn.setAttribute('disabled', 'true');
      }

      try {
        const updatePayload: any = {};
        if (newName) {
          updatePayload.data = { name: newName };
        }
        if (newPassword) {
          if (newPassword.length < 6) {
            throw new Error('Kata sandi minimal harus 6 karakter.');
          }
          updatePayload.password = newPassword;
        }

        const { error } = await supabase.auth.updateUser(updatePayload);
        if (error) throw error;

        alert('Data akun administrator berhasil diperbarui!');
        if (newPasswordInput) newPasswordInput.value = '';
        window.location.reload();

      } catch (err: any) {
        console.error(err);
        alert('Gagal memperbarui akun: ' + (err.message || 'Terjadi kesalahan.'));
      } finally {
        if (saveBtn) {
          saveBtn.textContent = 'Simpan Perubahan Akun';
          saveBtn.removeAttribute('disabled');
        }
      }
    });
  });
</script>
