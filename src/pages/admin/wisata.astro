---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

// Fetch current wisata list from Supabase
const { data: dbWisata, error } = await supabase
  .from('wisata')
  .select('*')
  .order('id', { ascending: true });

const wisataList = dbWisata || [];
---

<AdminLayout title="Kelola Desa Wisata">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Desa Wisata</h1>
        <p class="text-muted-foreground mt-1">Kelola data potensi pariwisata dan objek wisata lokal Desa Puspamukti.</p>
      </div>
      <button 
        id="add-wisata-btn"
        class="inline-flex items-center justify-center rounded-xl text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 gap-2 shadow-md cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Tambah Objek Wisata
      </button>
    </div>

    <!-- Objek Wisata Table -->
    <div class="bg-card border rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-muted/50 text-muted-foreground font-semibold border-b">
            <tr>
              <th class="px-6 py-4">Foto</th>
              <th class="px-6 py-4">Nama Destinasi</th>
              <th class="px-6 py-4">Kategori Wisata</th>
              <th class="px-6 py-4">Deskripsi Singkat</th>
              <th class="px-6 py-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y" id="wisata-table-body">
            {wisataList.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-muted-foreground">
                  Belum ada data objek wisata. Silakan tambah data baru.
                </td>
              </tr>
            ) : (
              wisataList.map((item) => (
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="px-6 py-4">
                    <div class="w-12 h-9 rounded bg-muted overflow-hidden flex items-center justify-center border">
                      {item.gambar_url ? (
                        <img src={item.gambar_url} alt={item.nama} class="w-full h-full object-cover" />
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-4 font-bold text-foreground">{item.nama}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold bg-secondary text-secondary-foreground">
                      {item.kategori}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-muted-foreground max-w-xs truncate">{item.deskripsi}</td>
                  <td class="px-6 py-4 text-right whitespace-nowrap">
                    <button 
                      class="edit-btn text-primary hover:underline text-xs font-bold mr-3 cursor-pointer"
                      data-id={item.id}
                      data-nama={item.nama}
                      data-kategori={item.kategori}
                      data-deskripsi={item.deskripsi}
                      data-gambar={item.gambar_url || ''}
                    >
                      Edit
                    </button>
                    <button 
                      class="delete-btn text-destructive hover:underline text-xs font-bold cursor-pointer"
                      data-id={item.id}
                      data-nama={item.nama}
                    >
                      Hapus
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Dialog Modal (Add/Edit Form) -->
  <div id="wisata-modal" class="fixed inset-0 bg-background/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-card border w-full max-w-lg rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
      <div class="px-6 py-5 border-b flex justify-between items-center bg-muted/20">
        <h3 id="modal-title" class="font-bold text-lg text-foreground">Tambah Objek Wisata</h3>
        <button id="close-modal-btn" class="p-1.5 rounded-lg hover:bg-muted text-muted-foreground hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      
      <form id="wisata-form" class="p-6 overflow-y-auto space-y-4 flex-1" novalidate>
        <input type="hidden" id="wisata-id" />
        <input type="hidden" id="wisata-gambar-existing" />
        
        <div class="space-y-1.5 text-left">
          <label for="wisata-nama" class="text-xs font-bold text-foreground uppercase tracking-wider">Nama Objek Wisata</label>
          <input 
            type="text" 
            id="wisata-nama" 
            placeholder="Contoh: Wisata Alam Curug Cipicung" 
            class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-2xs transition-colors"
            required
          />
          <p id="wisata-nama-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Nama objek wisata wajib diisi (minimal 3 huruf).</span>
          </p>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="wisata-kategori" class="text-xs font-bold text-foreground uppercase tracking-wider">Kategori Wisata</label>
          <select 
            id="wisata-kategori" 
            class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shadow-2xs"
            required
          >
            <option value="Wisata Alam">Wisata Alam</option>
            <option value="Wisata Budaya">Wisata Budaya</option>
            <option value="Agrowisata">Agrowisata</option>
            <option value="Kuliner">Kuliner</option>
            <option value="Edukasi">Edukasi</option>
          </select>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="wisata-gambar-file" class="text-xs font-bold text-foreground uppercase tracking-wider">Foto Objek Wisata (Pilih File Gambar)</label>
          <div class="flex items-center gap-4">
            <div class="w-16 h-12 bg-muted border rounded-lg flex items-center justify-center overflow-hidden shrink-0" id="wisata-gambar-preview">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
            <div class="flex flex-col gap-1.5 w-full">
              <input 
                type="file" 
                id="wisata-gambar-file" 
                accept="image/*"
                class="block w-full text-xs text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-primary-foreground hover:file:bg-primary/90 cursor-pointer"
              />
              <button type="button" id="delete-wisata-gambar-btn" class="inline-flex items-center justify-center rounded-lg border border-destructive/20 text-[10px] text-destructive hover:bg-destructive/10 font-bold h-7 px-3 w-fit cursor-pointer transition-colors">
                Hapus Foto Wisata
              </button>
            </div>
          </div>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="wisata-deskripsi" class="text-xs font-bold text-foreground uppercase tracking-wider">Deskripsi Daya Tarik Wisata</label>
          <textarea 
            id="wisata-deskripsi" 
            rows="4" 
            placeholder="Tuliskan cerita daya tarik, rute, atau jam buka destinasi secara detail..." 
            class="flex w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary resize-none shadow-2xs transition-colors"
            required
          ></textarea>
          <p id="wisata-desc-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Deskripsi objek wisata wajib diisi (minimal 10 huruf).</span>
          </p>
        </div>

        <div class="pt-4 border-t flex justify-end gap-3">
          <button 
            type="button" 
            id="cancel-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl border border-input bg-background hover:bg-accent text-sm font-bold h-11 px-4 cursor-pointer transition-colors"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="submit-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-bold h-11 px-6 shadow-md hover:shadow-lg cursor-pointer transition-all"
          >
            Simpan Destinasi
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const BUCKET_NAME = 'desa-media';

  const modal = document.getElementById('wisata-modal');
  const modalTitle = document.getElementById('modal-title');
  const wisataForm = document.getElementById('wisata-form') as HTMLFormElement;
  
  const inputId = document.getElementById('wisata-id') as HTMLInputElement;
  const inputNama = document.getElementById('wisata-nama') as HTMLInputElement;
  const inputKategori = document.getElementById('wisata-kategori') as HTMLSelectElement;
  const inputGambarFile = document.getElementById('wisata-gambar-file') as HTMLInputElement;
  const inputGambarUrlExisting = document.getElementById('wisata-gambar-existing') as HTMLInputElement;
  const previewGambar = document.getElementById('wisata-gambar-preview');
  const inputDeskripsi = document.getElementById('wisata-deskripsi') as HTMLTextAreaElement;
  const deleteWisataGambarBtn = document.getElementById('delete-wisata-gambar-btn');
  
  const addBtn = document.getElementById('add-wisata-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const submitModalBtn = document.getElementById('submit-modal-btn');

  // Preview Photo File Change
  if (inputGambarFile) {
    inputGambarFile.addEventListener('change', () => {
      const file = inputGambarFile.files?.[0];
      if (file && previewGambar) {
        const url = URL.createObjectURL(file);
        previewGambar.innerHTML = `<img src="${url}" class="w-full h-full object-cover" />`;
      }
    });
  }

  // Handle Delete Wisata Photo Click
  if (deleteWisataGambarBtn) {
    deleteWisataGambarBtn.addEventListener('click', () => {
      if (inputGambarFile) inputGambarFile.value = "";
      if (inputGambarUrlExisting) inputGambarUrlExisting.value = "";
      if (previewGambar) {
        previewGambar.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;
      }
    });
  }

  // Upload helper to Supabase Storage
  const uploadImage = async (file: File, folder: string): Promise<string> => {
    const ext = file.name.split('.').pop();
    const cleanName = `${folder}/${Date.now()}_${Math.random().toString(36).substring(7)}.${ext}`;

    const { data, error } = await supabase.storage
      .from(BUCKET_NAME)
      .upload(cleanName, file, {
        cacheControl: '3600',
        upsert: false
      });

    if (error) throw error;

    const { data: urlData } = supabase.storage
      .from(BUCKET_NAME)
      .getPublicUrl(cleanName);

    return urlData.publicUrl;
  };

  // Open Modal Helper
  const openModal = (title: string, id = "", nama = "", kategori = "Wisata Alam", gambar = "", deskripsi = "") => {
    if (!modal) return;
    if (modalTitle) modalTitle.innerText = title;
    
    inputId.value = id;
    inputNama.value = nama;
    inputKategori.value = kategori;
    inputGambarUrlExisting.value = gambar;
    inputDeskripsi.value = deskripsi;

    if (inputGambarFile) inputGambarFile.value = "";

    if (gambar && previewGambar) {
      previewGambar.innerHTML = `<img src="${gambar}" class="w-full h-full object-cover" />`;
    } else if (previewGambar) {
      previewGambar.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;
    }

    namaError?.classList.add('hidden');
    descError?.classList.add('hidden');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  const namaError = document.getElementById('wisata-nama-error');
  const descError = document.getElementById('wisata-desc-error');

  function validateWisataForm(): boolean {
    let valid = true;

    if (inputNama.value.trim().length < 3) {
      inputNama.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputNama.classList.remove('border-input', 'focus-visible:ring-primary');
      namaError?.classList.remove('hidden');
      valid = false;
    } else {
      inputNama.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputNama.classList.add('border-input', 'focus-visible:ring-primary');
      namaError?.classList.add('hidden');
    }

    if (inputDeskripsi.value.trim().length < 10) {
      inputDeskripsi.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputDeskripsi.classList.remove('border-input', 'focus-visible:ring-primary');
      descError?.classList.remove('hidden');
      valid = false;
    } else {
      inputDeskripsi.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputDeskripsi.classList.add('border-input', 'focus-visible:ring-primary');
      descError?.classList.add('hidden');
    }

    return valid;
  }

  inputNama?.addEventListener('input', () => { if (!namaError?.classList.contains('hidden')) validateWisataForm(); });
  inputDeskripsi?.addEventListener('input', () => { if (!descError?.classList.contains('hidden')) validateWisataForm(); });

  // Close Modal Helper
  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove('flex');
    modal.classList.add('hidden');
    wisataForm.reset();
    namaError?.classList.add('hidden');
    descError?.classList.add('hidden');
  };

  // Listeners for Modal controls
  if (addBtn) addBtn.addEventListener('click', () => openModal("Tambah Objek Wisata"));
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
  if (cancelModalBtn) cancelModalBtn.addEventListener('click', closeModal);

  // Submit Handler
  if (wisataForm) {
    wisataForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateWisataForm()) return;

      const id = inputId.value;
      const nama = inputNama.value.trim();
      const kategori = inputKategori.value;
      const fileGambar = inputGambarFile.files?.[0];
      const deskripsi = inputDeskripsi.value.trim();

      if (submitModalBtn) {
        submitModalBtn.innerText = "Menyimpan...";
        submitModalBtn.setAttribute('disabled', 'true');
      }

      try {
        let gambar_url = inputGambarUrlExisting.value || null;

        if (fileGambar) {
          submitModalBtn.innerText = "Mengunggah Foto...";
          gambar_url = await uploadImage(fileGambar, 'wisata');
        }

        const payload = { nama, kategori, gambar_url, deskripsi };

        if (id) {
          // Edit Mode
          const { error } = await supabase
            .from('wisata')
            .update(payload)
            .eq('id', parseInt(id));

          if (error) throw error;
        } else {
          // Add Mode
          const { error } = await supabase
            .from('wisata')
            .insert([payload]);

          if (error) throw error;
        }
        window.location.reload();
      } catch (err: any) {
        alert("Gagal menyimpan data: " + err.message);
      } finally {
        if (submitModalBtn) {
          submitModalBtn.innerText = "Simpan Destinasi";
          submitModalBtn.removeAttribute('disabled');
        }
      }
    });
  }

  // Row Action Listeners (Edit & Delete) - Initialized directly to avoid lifecycle issues
  // Edit action
  const editBtns = document.querySelectorAll('.edit-btn');
  editBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      const id = el.getAttribute('data-id') || "";
      const nama = el.getAttribute('data-nama') || "";
      const kategori = el.getAttribute('data-kategori') || "Wisata Alam";
      const deskripsi = el.getAttribute('data-deskripsi') || "";
      const gambar = el.getAttribute('data-gambar') || "";

      openModal("Edit Objek Wisata", id, nama, kategori, gambar, deskripsi);
    });
  });

  // Delete action
  const deleteBtns = document.querySelectorAll('.delete-btn');
  deleteBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      const id = el.getAttribute('data-id');
      const nama = el.getAttribute('data-nama');
      if (!id) return;

      if (confirm(`Apakah Anda yakin ingin menghapus destinasi "${nama}"?`)) {
        const { error } = await supabase
          .from('wisata')
          .delete()
          .eq('id', parseInt(id));

        if (error) {
          alert("Gagal menghapus data: " + error.message);
        } else {
          alert("Destinasi wisata berhasil dihapus!");
          window.location.reload();
        }
      }
    });
  });
</script>
