---
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Login Admin - Desa Puspamukti">
  <div class="min-h-screen flex items-center justify-center p-4">
    <!-- Login Card -->
    <div class="w-full max-w-5xl bg-card rounded-3xl border shadow-xl flex flex-col md:flex-row overflow-hidden min-h-[600px] relative">
      
      <!-- Kiri: Form Login -->
      <div class="w-full md:w-1/2 p-8 md:p-12 lg:p-16 flex flex-col justify-center relative">
        <!-- Back to Home -->
        <a href="/" class="absolute top-6 left-6 md:top-8 md:left-8 inline-flex items-center text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="m15 18-6-6 6-6"/></svg>
          Kembali ke Portal
        </a>

        <div class="mb-8 mt-8 flex justify-center md:justify-start">
          <img src="/logodesa.webp" alt="Logo Desa Puspamukti" class="h-14 w-auto drop-shadow-sm" />
        </div>
        
        <div class="space-y-2 mb-8 text-center md:text-left">
          <h1 class="text-3xl font-bold tracking-tight text-foreground">Portal Aparatur</h1>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Silakan masuk menggunakan kredensial yang telah diberikan untuk mengakses dasbor pengelolaan website desa.
          </p>
        </div>

        <form id="login-form" class="space-y-5" novalidate>
          <div class="space-y-1.5 text-left">
            <label for="email" class="text-xs font-bold text-foreground uppercase tracking-wider">Alamat Email Aparatur</label>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <input 
                type="email" 
                id="email" 
                class="flex h-12 w-full rounded-xl border border-input bg-background pl-10 pr-4 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
                placeholder="Contoh: admin@puspamukti.id" 
                required 
              />
            </div>
            <!-- Inline Error Message for Email -->
            <p id="email-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <span id="email-error-text">Format email tidak valid (harus mengandung @ dan domain).</span>
            </p>
          </div>

          <div class="space-y-1.5 text-left">
            <div class="flex items-center justify-between">
              <label for="password" class="text-xs font-bold text-foreground uppercase tracking-wider">Kata Sandi</label>
            </div>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input 
                type="password" 
                id="password" 
                class="flex h-12 w-full rounded-xl border border-input bg-background pl-10 pr-4 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
                placeholder="••••••••" 
                required 
              />
            </div>
            <!-- Inline Error Message for Password -->
            <p id="password-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <span id="password-error-text">Kata sandi tidak boleh kosong.</span>
            </p>
          </div>

          <button type="submit" id="login-submit-btn" class="w-full inline-flex items-center justify-center rounded-xl text-sm font-bold transition-all bg-primary text-primary-foreground hover:bg-primary/90 h-12 px-4 py-2 shadow-md hover:shadow-lg cursor-pointer">
            Masuk ke Dasbor
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>

        <div class="mt-8 text-center md:text-left">
          <p class="text-[11px] text-muted-foreground flex items-center justify-center md:justify-start gap-1.5 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Sistem Informasi Khusus Aparatur Pemerintahan Desa Puspamukti
          </p>
        </div>
      </div>

      <!-- Kanan: Dekorasi / Banner -->
      <div class="w-full md:w-1/2 bg-primary relative hidden md:block">
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary to-primary-foreground/20"></div>
        <!-- Pattern Overlay -->
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+CiAgPGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4xNSkiLz4KPC9zdmc+')] bg-repeat opacity-50"></div>
        
        <div class="absolute inset-0 flex flex-col items-center justify-center text-primary-foreground p-12 text-center">
          <div class="w-24 h-24 bg-background/10 backdrop-blur rounded-3xl border border-primary-foreground/20 flex items-center justify-center mb-8 shadow-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h2 class="text-3xl font-bold mb-4">Aman & Transparan</h2>
          <p class="text-primary-foreground/90 leading-relaxed max-w-sm text-lg">
            Ruang kendali digital untuk mewujudkan tata kelola Desa Puspamukti yang informatif dan profesional.
          </p>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Custom User-Friendly Validation Popup Modal -->
  <div id="auth-modal" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
    <div class="w-full max-w-md bg-card border rounded-3xl shadow-2xl p-6 sm:p-8 text-center space-y-5 animate-scale-in">
      <div id="modal-icon-box" class="w-16 h-16 rounded-2xl bg-destructive/10 text-destructive flex items-center justify-center mx-auto border border-destructive/20 shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
      </div>

      <div class="space-y-2">
        <h3 id="modal-title" class="text-xl font-extrabold text-foreground">Email atau Kata Sandi Salah</h3>
        <p id="modal-desc" class="text-sm text-muted-foreground leading-relaxed">
          Maaf, kombinasi email atau kata sandi yang Anda masukkan tidak sesuai. Silakan periksa kembali dan coba lagi.
        </p>
      </div>

      <button id="modal-close-btn" class="w-full inline-flex items-center justify-center rounded-xl text-sm font-bold bg-primary text-primary-foreground hover:bg-primary/90 h-12 shadow-md cursor-pointer transition-all">
        Coba Lagi
      </button>
    </div>
  </div>
</AuthLayout>

<script>
  import { supabase } from '../../lib/supabase';

  // Check if session already exists
  async function checkSession() {
    const { data: { session } } = await supabase.auth.getSession();
    const localAdmin = localStorage.getItem('admin_session');
    if (session || localAdmin) {
      window.location.href = '/admin';
    }
  }
  checkSession();

  const loginForm = document.getElementById('login-form');
  const submitBtn = document.getElementById('login-submit-btn');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  const emailError = document.getElementById('email-error');
  const emailErrorText = document.getElementById('email-error-text');
  const passwordError = document.getElementById('password-error');
  const passwordErrorText = document.getElementById('password-error-text');

  // Custom Modal Elements
  const modal = document.getElementById('auth-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  function showModal(title: string, message: string) {
    if (modalTitle) modalTitle.textContent = title;
    if (modalDesc) modalDesc.textContent = message;
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function hideModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    passwordInput?.focus();
  }

  modalCloseBtn?.addEventListener('click', hideModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) hideModal();
  });

  // Real-time Email Inline Validation
  function validateEmail(): boolean {
    const val = emailInput?.value.trim() || '';
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    
    if (!val) {
      emailInput?.classList.add('border-destructive', 'focus-visible:ring-destructive');
      emailInput?.classList.remove('border-input', 'focus-visible:ring-primary');
      if (emailErrorText) emailErrorText.textContent = 'Alamat email aparatur tidak boleh kosong.';
      emailError?.classList.remove('hidden');
      return false;
    } else if (!emailRegex.test(val)) {
      emailInput?.classList.add('border-destructive', 'focus-visible:ring-destructive');
      emailInput?.classList.remove('border-input', 'focus-visible:ring-primary');
      if (emailErrorText) emailErrorText.textContent = 'Format email tidak valid (Contoh yang benar: admin@puspamukti.id)';
      emailError?.classList.remove('hidden');
      return false;
    } else {
      emailInput?.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      emailInput?.classList.add('border-input', 'focus-visible:ring-primary');
      emailError?.classList.add('hidden');
      return true;
    }
  }

  // Real-time Password Inline Validation
  function validatePassword(): boolean {
    const val = passwordInput?.value.trim() || '';
    if (!val) {
      passwordInput?.classList.add('border-destructive', 'focus-visible:ring-destructive');
      passwordInput?.classList.remove('border-input', 'focus-visible:ring-primary');
      if (passwordErrorText) passwordErrorText.textContent = 'Kata sandi tidak boleh kosong.';
      passwordError?.classList.remove('hidden');
      return false;
    } else {
      passwordInput?.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      passwordInput?.classList.add('border-input', 'focus-visible:ring-primary');
      passwordError?.classList.add('hidden');
      return true;
    }
  }

  emailInput?.addEventListener('input', () => {
    if (!emailError?.classList.contains('hidden')) validateEmail();
  });

  passwordInput?.addEventListener('input', () => {
    if (!passwordError?.classList.contains('hidden')) validatePassword();
  });

  if (loginForm && submitBtn) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const isEmailValid = validateEmail();
      const isPasswordValid = validatePassword();

      if (!isEmailValid || !isPasswordValid) {
        return;
      }

      const email = emailInput.value.trim();
      const password = passwordInput.value.trim();

      submitBtn.innerText = "Memeriksa Kredensial...";
      submitBtn.setAttribute('disabled', 'true');

      // 100% Pure Supabase Authentication
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error || !data || !data.session) {
        showModal(
          'Email atau Kata Sandi Salah', 
          'Maaf, alamat email atau kata sandi yang Anda masukkan tidak cocok di database aparatur desa. Mohon periksa kembali pengetikannya.'
        );
        
        submitBtn.innerHTML = `
          Masuk ke Dasbor
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        `;
        submitBtn.removeAttribute('disabled');
        return;
      }

      // Save session from verified Supabase Auth
      localStorage.setItem('admin_session', JSON.stringify({
        id: data.session.user.id,
        email: data.session.user.email,
        name: data.session.user.user_metadata?.name || data.session.user.email?.split('@')[0] || 'Administrator Desa',
        role: data.session.user.user_metadata?.role || 'Aparatur Desa',
        time: Date.now()
      }));

      window.location.href = '/admin';
    });
  }
</script>
