---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

// Fetch BUMDes Profile from Supabase
const { data: dbProfil } = await supabase
  .from('bumdes_profil')
  .select('*')
  .eq('id', 1)
  .single();

// Fetch BUMDes Units from Supabase
const { data: dbUnits } = await supabase
  .from('bumdes_unit')
  .select('*')
  .order('created_at', { ascending: true });

const profil = dbProfil;
const units = dbUnits || [];
---

<AdminLayout title="Kelola BUMDes">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Kelola BUMDes</h1>
        <p class="text-muted-foreground mt-1">Kelola profil nama BUMDes serta unit-unit usaha ekonomi desa.</p>
      </div>
      <button 
        id="add-unit-btn"
        class="inline-flex items-center justify-center rounded-xl text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 gap-2 shadow-md cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        Tambah Unit Usaha
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-fade-in">
      
      <!-- Left Column: Edit BUMDes Profile -->
      <div class="space-y-6">
        <form id="profil-form" class="bg-card border rounded-3xl p-6 shadow-sm space-y-6">
          <div class="flex justify-between items-center border-b pb-4">
            <h3 class="font-bold text-lg text-foreground">Profil BUMDes</h3>
            <button 
              type="submit" 
              id="save-profil-btn"
              class="inline-flex items-center justify-center rounded-xl text-xs font-bold bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 shadow-sm cursor-pointer"
            >
              Simpan Profil
            </button>
          </div>
          
          <div class="space-y-4">
            <div class="space-y-1.5 text-left">
              <label for="profil-nama" class="text-xs font-bold text-foreground uppercase tracking-wider">Nama Lembaga BUMDes</label>
              <input 
                type="text" 
                id="profil-nama" 
                value={profil ? profil.nama : ""} 
                placeholder="Contoh: BUMDes Bakti Mandiri Puspamukti"
                class="flex h-11 w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-2xs transition-colors"
                required
              />
              <p id="profil-nama-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <span>Nama BUMDes wajib diisi (minimal 3 huruf).</span>
              </p>
            </div>
            
            <div class="space-y-1.5 text-left">
              <label for="profil-deskripsi" class="text-xs font-bold text-foreground uppercase tracking-wider">Deskripsi / Visi Misi</label>
              <textarea 
                id="profil-deskripsi" 
                rows="4" 
                placeholder="Tulis visi, misi, atau deskripsi singkat tentang komitmen BUMDes desa Anda..."
                class="flex w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary resize-none shadow-2xs transition-colors"
                required
              >{profil ? profil.deskripsi : ""}</textarea>
              <p id="profil-desc-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <span>Deskripsi BUMDes wajib diisi (minimal 10 huruf).</span>
              </p>
            </div>

            <div class="space-y-1.5 text-left">
              <label for="profil-mitra" class="text-xs font-bold text-foreground uppercase tracking-wider">Jumlah Mitra UMKM</label>
              <input 
                type="number" 
                id="profil-mitra" 
                value={profil ? profil.total_mitra : 0} 
                placeholder="Contoh: 15"
                class="flex h-11 w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-2xs transition-colors"
                required
                min="0"
              />
            </div>
          </div>
        </form>
      </div>

      <!-- Right Column: Units List Table -->
      <div class="lg:col-span-2">
        <div class="bg-card border rounded-3xl shadow-sm overflow-hidden">
          <div class="px-6 py-5 border-b bg-muted/20">
            <h3 class="font-bold text-lg text-foreground">Daftar Unit Usaha Aktif</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="bg-muted/50 text-muted-foreground font-semibold border-b">
                <tr>
                  <th class="px-6 py-4">Nama Unit Usaha</th>
                  <th class="px-6 py-4">Kategori</th>
                  <th class="px-6 py-4">Deskripsi</th>
                  <th class="px-6 py-4 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y" id="unit-table-body">
                {units.length === 0 ? (
                  <tr>
                    <td colspan="4" class="px-6 py-8 text-center text-muted-foreground">
                      Belum ada unit usaha BUMDes yang terdaftar. Silakan tambah unit usaha baru.
                    </td>
                  </tr>
                ) : (
                  units.map((unit) => (
                    <tr class="hover:bg-muted/30 transition-colors">
                      <td class="px-6 py-4 font-bold text-foreground">{unit.nama}</td>
                      <td class="px-6 py-4">
                        <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold bg-secondary text-secondary-foreground">
                          {unit.kategori}
                        </span>
                      </td>
                      <td class="px-6 py-4 text-muted-foreground max-w-xs truncate">{unit.deskripsi}</td>
                      <td class="px-6 py-4 text-right whitespace-nowrap">
                        <button 
                          class="edit-unit-btn text-primary hover:underline text-xs font-bold mr-3 cursor-pointer"
                          data-id={unit.id}
                          data-nama={unit.nama}
                          data-kategori={unit.kategori}
                          data-deskripsi={unit.deskripsi}
                        >
                          Edit
                        </button>
                        <button 
                          class="delete-unit-btn text-destructive hover:underline text-xs font-bold cursor-pointer"
                          data-id={unit.id}
                          data-nama={unit.nama}
                        >
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Form Modal (Add/Edit Unit) -->
  <div id="unit-modal" class="fixed inset-0 bg-background/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-card border w-full max-w-md rounded-3xl shadow-xl overflow-hidden flex flex-col">
      <div class="px-6 py-5 border-b flex justify-between items-center bg-muted/20">
        <h3 id="modal-title" class="font-bold text-lg text-foreground font-sans">Tambah Unit Usaha</h3>
        <button id="close-modal-btn" class="p-1.5 rounded-lg hover:bg-muted text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="unit-form" class="p-6 space-y-4" novalidate>
        <input type="hidden" id="unit-id" />
        
        <div class="space-y-1.5 text-left">
          <label for="unit-nama" class="text-xs font-bold text-foreground uppercase tracking-wider">Nama Unit Usaha</label>
          <input 
            type="text" 
            id="unit-nama" 
            placeholder="Contoh: Unit Agribisnis & Pertanian" 
            class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-2xs transition-colors"
            required
          />
          <p id="unit-nama-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Nama unit usaha wajib diisi (minimal 3 huruf).</span>
          </p>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="unit-kategori" class="text-xs font-bold text-foreground uppercase tracking-wider">Kategori Bidang</label>
          <select 
            id="unit-kategori" 
            class="flex h-11 w-full rounded-xl border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shadow-2xs"
            required
          >
            <option value="Perdagangan">Perdagangan</option>
            <option value="Pertanian">Pertanian</option>
            <option value="Jasa Keuangan">Jasa Keuangan</option>
            <option value="Penyewaan">Penyewaan</option>
            <option value="Pariwisata">Pariwisata</option>
            <option value="Jasa">Jasa</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>

        <div class="space-y-1.5 text-left">
          <label for="unit-deskripsi" class="text-xs font-bold text-foreground uppercase tracking-wider">Deskripsi Operasional / Layanan</label>
          <textarea 
            id="unit-deskripsi" 
            rows="3" 
            placeholder="Tulis lengkap layanan atau produk yang ditawarkan oleh unit usaha BUMDes ini..."
            class="flex w-full rounded-xl border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary resize-none shadow-2xs transition-colors"
            required
          ></textarea>
          <p id="unit-desc-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Deskripsi unit usaha wajib diisi (minimal 5 huruf).</span>
          </p>
        </div>

        <div class="pt-4 border-t flex justify-end gap-3">
          <button 
            type="button" 
            id="cancel-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl border border-input bg-background hover:bg-accent text-sm font-bold h-11 px-4 cursor-pointer transition-colors"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="submit-modal-btn" 
            class="inline-flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-bold h-11 px-6 shadow-md hover:shadow-lg cursor-pointer transition-all"
          >
            Simpan Unit Usaha
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  // --- 1. PROFILE SUBMIT ---
  const profilForm = document.getElementById('profil-form');
  const saveProfilBtn = document.getElementById('save-profil-btn');
  const inputProfilNama = document.getElementById('profil-nama') as HTMLInputElement;
  const inputProfilDesc = document.getElementById('profil-deskripsi') as HTMLTextAreaElement;
  const inputProfilMitra = document.getElementById('profil-mitra') as HTMLInputElement;
  const profilNamaError = document.getElementById('profil-nama-error');
  const profilDescError = document.getElementById('profil-desc-error');

  function validateProfilForm(): boolean {
    let valid = true;
    if (inputProfilNama.value.trim().length < 3) {
      inputProfilNama.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputProfilNama.classList.remove('border-input', 'focus-visible:ring-primary');
      profilNamaError?.classList.remove('hidden');
      valid = false;
    } else {
      inputProfilNama.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputProfilNama.classList.add('border-input', 'focus-visible:ring-primary');
      profilNamaError?.classList.add('hidden');
    }

    if (inputProfilDesc.value.trim().length < 10) {
      inputProfilDesc.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputProfilDesc.classList.remove('border-input', 'focus-visible:ring-primary');
      profilDescError?.classList.remove('hidden');
      valid = false;
    } else {
      inputProfilDesc.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputProfilDesc.classList.add('border-input', 'focus-visible:ring-primary');
      profilDescError?.classList.add('hidden');
    }
    return valid;
  }

  inputProfilNama?.addEventListener('input', () => { if (!profilNamaError?.classList.contains('hidden')) validateProfilForm(); });
  inputProfilDesc?.addEventListener('input', () => { if (!profilDescError?.classList.contains('hidden')) validateProfilForm(); });

  if (profilForm) {
    profilForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateProfilForm()) return;
      
      const nama = inputProfilNama.value.trim();
      const deskripsi = inputProfilDesc.value.trim();
      const total_mitra = parseInt(inputProfilMitra.value) || 0;

      if (saveProfilBtn) {
        saveProfilBtn.innerText = "Menyimpan...";
        saveProfilBtn.setAttribute('disabled', 'true');
      }

      // Upsert record at ID 1
      const { error } = await supabase
        .from('bumdes_profil')
        .upsert({
          id: 1,
          nama,
          deskripsi,
          total_mitra,
          updated_at: new Date().toISOString()
        });

      if (error) {
        alert("Gagal memperbarui profil: " + error.message);
      } else {
        window.location.reload();
      }

      if (saveProfilBtn) {
        saveProfilBtn.innerText = "Simpan Profil";
        saveProfilBtn.removeAttribute('disabled');
      }
    });
  }

  // --- 2. MANAGING UNITS MODAL ---
  const modal = document.getElementById('unit-modal');
  const modalTitle = document.getElementById('modal-title');
  const unitForm = document.getElementById('unit-form') as HTMLFormElement;
  
  const inputId = document.getElementById('unit-id') as HTMLInputElement;
  const inputNama = document.getElementById('unit-nama') as HTMLInputElement;
  const selectKategori = document.getElementById('unit-kategori') as HTMLSelectElement;
  const textareaDesc = document.getElementById('unit-deskripsi') as HTMLTextAreaElement;
  const unitNamaError = document.getElementById('unit-nama-error');
  const unitDescError = document.getElementById('unit-desc-error');

  const addBtn = document.getElementById('add-unit-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const cancelBtn = document.getElementById('cancel-modal-btn');
  const submitBtn = document.getElementById('submit-modal-btn');

  function validateUnitForm(): boolean {
    let valid = true;
    if (inputNama.value.trim().length < 3) {
      inputNama.classList.add('border-destructive', 'focus-visible:ring-destructive');
      inputNama.classList.remove('border-input', 'focus-visible:ring-primary');
      unitNamaError?.classList.remove('hidden');
      valid = false;
    } else {
      inputNama.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputNama.classList.add('border-input', 'focus-visible:ring-primary');
      unitNamaError?.classList.add('hidden');
    }

    if (textareaDesc.value.trim().length < 5) {
      textareaDesc.classList.add('border-destructive', 'focus-visible:ring-destructive');
      textareaDesc.classList.remove('border-input', 'focus-visible:ring-primary');
      unitDescError?.classList.remove('hidden');
      valid = false;
    } else {
      textareaDesc.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      textareaDesc.classList.add('border-input', 'focus-visible:ring-primary');
      unitDescError?.classList.add('hidden');
    }
    return valid;
  }

  inputNama?.addEventListener('input', () => { if (!unitNamaError?.classList.contains('hidden')) validateUnitForm(); });
  textareaDesc?.addEventListener('input', () => { if (!unitDescError?.classList.contains('hidden')) validateUnitForm(); });

  const openModal = (title: string, id = "", nama = "", kategori = "Perdagangan", deskripsi = "") => {
    if (!modal) return;
    if (modalTitle) modalTitle.innerText = title;
    
    inputId.value = id;
    inputNama.value = nama;
    selectKategori.value = kategori;
    textareaDesc.value = deskripsi;

    unitNamaError?.classList.add('hidden');
    unitDescError?.classList.add('hidden');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove('flex');
    modal.classList.add('hidden');
    unitForm.reset();
    unitNamaError?.classList.add('hidden');
    unitDescError?.classList.add('hidden');
  };

  if (addBtn) addBtn.addEventListener('click', () => openModal("Tambah Unit Usaha"));
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

  if (unitForm) {
    unitForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateUnitForm()) return;
      
      const id = inputId.value;
      const payload = {
        nama: inputNama.value.trim(),
        kategori: selectKategori.value,
        deskripsi: textareaDesc.value.trim()
      };

      if (submitBtn) {
        submitBtn.innerText = "Menyimpan...";
        submitBtn.setAttribute('disabled', 'true');
      }

      if (id) {
        const { error } = await supabase
          .from('bumdes_unit')
          .update(payload)
          .eq('id', parseInt(id));

        if (error) alert("Gagal mengupdate unit: " + error.message);
        else { window.location.reload(); }
      } else {
        const { error } = await supabase
          .from('bumdes_unit')
          .insert([payload]);

        if (error) alert("Gagal menambahkan unit: " + error.message);
        else { window.location.reload(); }
      }
    });
  }

  // Row Action Buttons
  document.addEventListener('DOMContentLoaded', () => {
    // Edit Action
    const editBtns = document.querySelectorAll('.edit-unit-btn');
    editBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLButtonElement;
        const id = el.getAttribute('data-id') || "";
        const nama = el.getAttribute('data-nama') || "";
        const kategori = el.getAttribute('data-kategori') || "Perdagangan";
        const deskripsi = el.getAttribute('data-deskripsi') || "";

        openModal("Edit Unit Usaha", id, nama, kategori, deskripsi);
      });
    });

    // Delete Action
    const deleteBtns = document.querySelectorAll('.delete-unit-btn');
    deleteBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const el = e.currentTarget as HTMLButtonElement;
        const id = el.getAttribute('data-id');
        const nama = el.getAttribute('data-nama');
        if (!id) return;

        if (confirm(`Apakah Anda yakin ingin menghapus unit usaha "${nama}"?`)) {
          const { error } = await supabase
            .from('bumdes_unit')
            .delete()
            .eq('id', parseInt(id));

          if (error) alert("Gagal menghapus unit: " + error.message);
          else { alert("Unit usaha berhasil dihapus!"); window.location.reload(); }
        }
      });
    });
  });
</script>
