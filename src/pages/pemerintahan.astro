---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch all staff from Supabase (to display under matching categories)
const { data: dbStaff } = await supabase
  .from('perangkat_desa')
  .select('*')
  .order('urutan', { ascending: true });

const staffList = dbStaff || [];
const pemdesList = staffList.filter(s => s.kategori === 'pemdes');

// Fetch organization chart settings from Supabase (stored in pengaturan_kontak)
const { data: dbSettings } = await supabase
  .from('pengaturan_kontak')
  .select('*')
  .eq('id', 1)
  .single();

const settings = dbSettings || { bagan_pemdes_url: "", bagan_bpd_url: "", bagan_lpmd_url: "", bagan_pkk_url: "" };

// Fetch all Kelembagaan (LKD) from Supabase
const { data: dbKelembagaan } = await supabase
  .from('layanan_kelembagaan')
  .select('*')
  .eq('tipe', 'Kelembagaan')
  .order('id', { ascending: true });

const kelembagaanList = dbKelembagaan || [];
---

<Layout title="Pemerintahan & Kelembagaan - Desa Puspamukti">
  <div class="container mx-auto px-4 max-w-screen-xl py-12 md:py-20 space-y-16">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <div class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-semibold border-primary/20 bg-primary/10 text-primary mb-2">
        Aparatur & Kelembagaan
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-foreground">
        Pemerintahan & Lembaga
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed font-normal">
        Struktur organisasi eksekutif resmi serta lembaga kemitraan LKD yang bersinergi melayani warga Desa Puspamukti.
      </p>
    </div>

    <!-- SECTION 1: PEMERINTAH DESA (EKSEKUTIF) - ALWAYS VISIBLE -->
    <div class="space-y-10 max-w-6xl mx-auto pt-10 border-t">
      <div class="text-center space-y-2">
        <h2 class="text-3xl font-bold text-foreground">Pemerintah Desa</h2>
        <p class="text-muted-foreground leading-relaxed">Jajaran eksekutif pelaksana pelayanan publik dan administrasi Desa Puspamukti.</p>
      </div>

      <!-- Bagan Struktur Pemdes -->
      <div class="bg-card border rounded-3xl p-6 md:p-8 shadow-sm space-y-6 max-w-5xl mx-auto animate-fade-in">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b pb-4">
          <div>
            <h3 class="font-bold text-lg text-foreground">Bagan Struktur Pemdes</h3>
            <p class="text-xs text-muted-foreground mt-0.5">Bagan resmi tata kerja Pemerintah Desa Puspamukti.</p>
          </div>
          <div>
            <button class="zoom-trigger-btn inline-flex items-center justify-center rounded-xl text-xs font-bold bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 gap-2 cursor-pointer transition-colors border" data-img={settings.bagan_pemdes_url || "/assets/struktur_pemdes.png"} data-fallback="/assets/struktur_organisasi.png">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
              Perbesar Bagan
            </button>
          </div>
        </div>
        <div class="relative rounded-2xl overflow-hidden border bg-muted/30 flex items-center justify-center min-h-[250px] md:min-h-[400px]">
          <img 
            src={settings.bagan_pemdes_url || "/assets/struktur_pemdes.png"} 
            alt="Bagan Struktur Pemdes" 
            class="max-w-full max-h-[500px] object-contain cursor-pointer zoomable-img"
            data-fallback="/assets/struktur_organisasi.png"
            onerror="this.src=this.getAttribute('data-fallback'); this.onerror=function(){this.style.display='none'; this.nextElementSibling.classList.remove('hidden');}"
          />
          <div class="hidden absolute inset-0 flex flex-col items-center justify-center p-8 text-center space-y-4 bg-muted/20">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
            <p class="text-xs text-muted-foreground max-w-sm">
              Bagan struktur Pemdes belum diunggah.
            </p>
          </div>
        </div>
      </div>

      <!-- Kartu Aparatur Pemdes -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 pt-4">
        {pemdesList.map((item) => (
          <div class="bg-card border rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all group flex flex-col">
            <div class="aspect-[4/5] bg-muted relative overflow-hidden flex items-center justify-center shrink-0">
              {item.foto_url ? (
                <img 
                  src={item.foto_url} 
                  alt={item.nama} 
                  width="300"
                  height="375"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
              ) : (
                <div class="absolute inset-0 flex flex-col items-center justify-center text-muted-foreground bg-primary/5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary/30"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              )}
            </div>
            <div class="p-4 text-center space-y-1 flex-1 flex flex-col justify-center">
              <h4 class="font-bold text-sm text-foreground leading-tight">{item.nama}</h4>
              <p class="text-xs text-primary font-semibold uppercase tracking-wider">{item.jabatan}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SECTION 2: GRID KELOMPOK LEMBAGA DESA (TAB CARDS) -->
    <div class="space-y-10 max-w-6xl mx-auto pt-16 border-t">
      <div class="text-center space-y-2">
        <h2 class="text-3xl font-bold text-foreground">Lembaga Kemasyarakatan Desa (LKD)</h2>
        <p class="text-muted-foreground leading-relaxed font-normal">Pilih salah satu lembaga kemitraan di bawah ini untuk melihat bagan struktur serta jajaran anggota pengurusnya.</p>
      </div>

      <!-- Grid Cards TP-PKK, BPD, LPMD, MUI, etc. -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="lkd-tabs-grid">
        {kelembagaanList.map((item, idx) => {
          const slug = item.nama.toLowerCase().replace(/\s+/g, '-');
          return (
            <button 
              class={`lkd-tab-btn flex flex-col items-center text-center p-5 border rounded-2xl bg-card hover:bg-muted/30 transition-all cursor-pointer shadow-sm relative group ${idx === 0 ? 'ring-2 ring-primary border-primary' : ''}`}
              data-target={`lkd-content-${slug}`}
            >
              <div class="w-12 h-12 rounded-xl overflow-hidden bg-primary/5 text-primary flex items-center justify-center border mb-3 shrink-0 group-hover:scale-105 transition-transform duration-300">
                {item.icon && (item.icon.startsWith('http') || item.icon.startsWith('/')) ? (
                  <img src={item.icon} alt={item.nama} class="w-full h-full object-cover" />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
              </div>
              <span class="font-bold text-sm text-foreground line-clamp-1 group-hover:text-primary transition-colors">{item.nama}</span>
            </button>
          );
        })}
      </div>

      <!-- DYNAMIC CONTENT CONTAINERS -->
      <div class="pt-6" id="lkd-content-container">
        {kelembagaanList.map((item, idx) => {
          const slug = item.nama.toLowerCase().replace(/\s+/g, '-');
          
          // Map corresponding database members from perangkat_desa
          let members = [];
          if (['bpd'].includes(slug)) {
            members = staffList.filter(s => s.kategori === 'bpd');
          } else if (['lpmd'].includes(slug)) {
            members = staffList.filter(s => s.kategori === 'lpmd');
          } else if (['tp-pkk', 'pkk'].includes(slug)) {
            members = staffList.filter(s => s.kategori === 'pkk' || s.kategori === 'tp-pkk');
          } else {
            members = staffList.filter(s => s.kategori === slug);
          }

          // Map Bagan URL
          let baganUrl = item.bagan_url || null;
          if (!baganUrl) {
            // Check fallback for BPD, LPMD, TP-PKK
            if (slug === 'bpd') baganUrl = settings.bagan_bpd_url || "/assets/struktur_bpd.png";
            else if (slug === 'lpmd') baganUrl = settings.bagan_lpmd_url || "/assets/struktur_lpmd.png";
            else if (['tp-pkk', 'pkk'].includes(slug)) baganUrl = settings.bagan_pkk_url || "/assets/struktur_pkk.png";
          }

          return (
            <div 
              class={`lkd-content-pane space-y-12 animate-fade-in ${idx === 0 ? '' : 'hidden'}`}
              id={`lkd-content-${slug}`}
            >
              
              <!-- Bagan Struktur Lembaga -->
              <div class="bg-card border rounded-3xl p-6 md:p-8 shadow-sm space-y-6 max-w-5xl mx-auto">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b pb-4">
                  <div>
                    <h3 class="font-bold text-lg text-foreground">Bagan Struktur {item.nama}</h3>
                    <p class="text-xs text-muted-foreground mt-0.5">{item.desc_singkat}</p>
                  </div>
                  {baganUrl && (
                    <div>
                      <button class="zoom-trigger-btn inline-flex items-center justify-center rounded-xl text-xs font-bold bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 gap-2 cursor-pointer transition-colors border" data-img={baganUrl}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
                        Perbesar Bagan
                      </button>
                    </div>
                  )}
                </div>

                <div class="relative rounded-2xl overflow-hidden border bg-muted/30 flex items-center justify-center min-h-[250px] md:min-h-[400px]">
                  {baganUrl ? (
                    <img 
                      src={baganUrl} 
                      alt={`Bagan Struktur ${item.nama}`} 
                      class="max-w-full max-h-[500px] object-contain cursor-pointer zoomable-img"
                      onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                    />
                  ) : null}
                  <div class={`${baganUrl ? 'hidden' : ''} absolute inset-0 flex flex-col items-center justify-center p-8 text-center space-y-4 bg-muted/20`}>
                    <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                    <p class="text-xs text-muted-foreground max-w-sm">
                      Bagan struktur untuk {item.nama} belum diunggah. Silakan unggah berkas melalui panel admin Kelembagaan.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Jajaran Anggota/Pengurus (Kartu Wajah) -->
              <div class="space-y-6 max-w-6xl mx-auto">
                <div class="border-b pb-2">
                  <h3 class="font-bold text-lg text-foreground">Jajaran Anggota & Pengurus</h3>
                  <p class="text-xs text-muted-foreground mt-0.5">Daftar personel resmi kepengurusan {item.nama} Desa Puspamukti.</p>
                </div>

                {members.length === 0 ? (
                  <div class="text-center py-10 bg-muted/20 rounded-2xl border border-dashed p-6 max-w-md mx-auto">
                    <p class="text-sm font-semibold text-foreground">Anggota Pengurus Belum Diisi</p>
                    <p class="text-xs text-muted-foreground mt-1">Gunakan panel admin Aparatur untuk mendaftarkan pengurus dan masukkan ke kategori "{item.nama}".</p>
                  </div>
                ) : (
                  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    {members.map((member) => (
                      <div class="bg-card border rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all group flex flex-col">
                        <div class="aspect-[4/5] bg-muted relative overflow-hidden flex items-center justify-center shrink-0">
                          {member.foto_url ? (
                            <img 
                              src={member.foto_url} 
                              alt={member.nama} 
                              width="300"
                              height="375"
                              loading="lazy"
                              decoding="async"
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                            />
                          ) : (
                            <div class="absolute inset-0 flex flex-col items-center justify-center text-muted-foreground bg-primary/5">
                              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary/30"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                          )}
                        </div>
                        <div class="p-4 text-center space-y-1 flex-1 flex flex-col justify-center">
                          <h4 class="font-bold text-sm text-foreground leading-tight">{member.nama}</h4>
                          <p class="text-xs text-primary font-semibold uppercase tracking-wider">{member.jabatan}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

            </div>
          );
        })}

        {kelembagaanList.length === 0 && (
          <p class="text-sm text-muted-foreground text-center py-8">Belum ada lembaga LKD yang didaftarkan.</p>
        )}
      </div>
    </div>

  </div>

  <!-- Zoom Lightbox Modal -->
  <div id="zoom-modal" class="fixed inset-0 z-50 bg-background/95 hidden items-center justify-center p-4">
    <button id="close-zoom" class="absolute top-6 right-6 p-2 rounded-full bg-card border hover:bg-muted text-foreground transition-colors cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="max-w-full max-h-full overflow-auto flex items-center justify-center">
      <img 
        src="" 
        alt="Bagan Struktur Organisasi Zoom" 
        class="max-w-[95vw] max-h-[90vh] object-contain rounded-lg shadow-2xl"
        id="modal-zoom-img"
        onerror="this.src='/assets/struktur_organisasi.png'"
      />
    </div>
  </div>
</Layout>

<script>
  // Dynamic Tab Switcher for LKD Sections
  const tabButtons = document.querySelectorAll('.lkd-tab-btn');
  const contentPanes = document.querySelectorAll('.lkd-content-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // 1. Remove ring/active classes from all buttons
      tabButtons.forEach(b => {
        b.classList.remove('ring-2', 'ring-primary', 'border-primary');
      });

      // 2. Add active ring to clicked button
      btn.classList.add('ring-2', 'ring-primary', 'border-primary');

      // 3. Hide all panes
      contentPanes.forEach(pane => {
        pane.classList.add('hidden');
      });

      // 4. Show corresponding pane
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const targetPane = document.getElementById(targetId);
        targetPane?.classList.remove('hidden');
      }
    });
  });

  // Zoom Modal Logic
  const zoomModal = document.getElementById('zoom-modal');
  const closeZoom = document.getElementById('close-zoom');
  const modalZoomImg = document.getElementById('modal-zoom-img') as HTMLImageElement;

  const openZoom = (imgSrc: string) => {
    if (zoomModal && modalZoomImg) {
      modalZoomImg.src = imgSrc;
      zoomModal.classList.remove('hidden');
      zoomModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  };

  const closeZoomModal = () => {
    if (zoomModal) {
      zoomModal.classList.remove('flex');
      zoomModal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };

  document.querySelectorAll('.zoom-trigger-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const img = btn.getAttribute('data-img');
      openZoom(img || '');
    });
  });

  document.querySelectorAll('.zoomable-img').forEach(img => {
    img.addEventListener('click', () => {
      const src = img.getAttribute('src');
      openZoom(src || '');
    });
  });

  if (closeZoom) closeZoom.addEventListener('click', closeZoomModal);
  if (zoomModal) {
    zoomModal.addEventListener('click', (e) => {
      if (e.target === zoomModal) closeZoomModal();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeZoomModal();
  });
</script>
