---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Fetch all special zones from Supabase
const { data: dbZones } = await supabase
  .from('zona_khusus')
  .select('*')
  .order('created_at', { ascending: true });

const zones = dbZones || [];

// Fallbacks if database is empty
const defaultZones = zones.length > 0 ? zones : [
  {
    nama: "Hutan Lindung & Konservasi",
    lokasi: "Wilayah Lereng Bukit Dusun 5 (Puncaksuji)",
    luas: "12,5 Hektar",
    deskripsi: "Zona perlindungan alam untuk menjaga resapan air bersih desa dan mencegah bencana tanah longsor. Dilarang melakukan penebangan pohon atau pembukaan lahan di area ini.",
    status: "Dilindungi"
  },
  {
    nama: "Tanah Carik Desa",
    lokasi: "Dusun 1 (Cipicung) & Dusun 3 (Kiarabongkok)",
    luas: "4,2 Hektar",
    deskripsi: "Aset tanah milik pemerintah desa yang saat ini dimanfaatkan sebagai lahan pertanian salak produktif dan persawahan kolaboratif untuk kas desa.",
    status: "Pemanfaatan Produktif"
  },
  {
    nama: "Cagar Budaya Makam Karomah",
    lokasi: "Dusun 2 (Ngenol)",
    luas: "0,5 Hektar",
    deskripsi: "Situs bersejarah religi dan makam sesepuh penyebar agama Islam terdahulu di Desa Puspamukti. Dijaga keasriannya sebagai warisan sejarah leluhur.",
    status: "Cagar Budaya"
  }
];

// Helper to map icons on the fly based on status
const getIconPath = (status: string) => {
  switch(status) {
    case 'Dilindungi':
      return 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z';
    case 'Pemanfaatan Produktif':
      return 'M3 21h18 M3 7v14 M21 7v14 M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16';
    case 'Cagar Budaya':
      return 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zm0-18v16M4 12h16';
    default:
      return 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z';
  }
};
---

<Layout title="Zona Khusus Desa - Desa Puspamukti">
  <div class="container mx-auto px-4 max-w-screen-xl py-12 md:py-20 space-y-12">
    
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-semibold border-primary/20 bg-primary/10 text-primary mb-2">
        Tata Ruang Wilayah
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground">Zona Wilayah Khusus</h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Daftar zonasi wilayah administratif Desa Puspamukti yang diperuntukkan bagi konservasi alam, cagar budaya, serta tata kelola aset tanah desa.
      </p>
    </div>

    <!-- Zones Grid -->
    {defaultZones.length === 0 ? (
      <div class="bg-card border rounded-3xl p-12 text-center max-w-xl mx-auto space-y-4 shadow-sm">
        <h3 class="text-xl font-bold text-foreground">Belum Ada Zona Khusus</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Belum ada penetapan tata ruang wilayah khusus yang terdaftar di database desa saat ini.
        </p>
      </div>
    ) : (
      <div class="space-y-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {defaultZones.map((zone) => (
            <div class="zona-card bg-card border rounded-3xl p-6 md:p-8 shadow-sm hover:shadow-md hover:border-primary/50 transition-all flex flex-col justify-between h-full">
              <div class="space-y-5">
                <!-- Icon & Status -->
                <div class="flex justify-between items-center">
                  <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d={getIconPath(zone.status)}></path>
                    </svg>
                  </div>
                  <span class={`px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                    zone.status === 'Dilindungi' ? 'bg-destructive/15 text-destructive' : 
                    zone.status === 'Cagar Budaya' ? 'bg-amber-500/15 text-amber-600' : 
                    'bg-green-500/15 text-green-600'
                  }`}>
                    {zone.status === 'Pemanfaatan Produktif' ? 'Pemanfaatan' : zone.status}
                  </span>
                </div>
                
                <!-- Title & Info -->
                <div class="space-y-2">
                  <h3 class="text-2xl font-bold text-foreground leading-tight">{zone.nama}</h3>
                  <div class="flex flex-col gap-1 text-xs text-muted-foreground font-semibold">
                    <span class="flex items-center gap-1.5">📍 Lokasi: {zone.lokasi}</span>
                    <span class="flex items-center gap-1.5">📐 Luas Area: {zone.luas}</span>
                  </div>
                </div>

                <!-- Description -->
                <p class="text-sm text-muted-foreground leading-relaxed font-medium">{zone.deskripsi}</p>
              </div>

              <!-- Bottom Warning/Disclaimer -->
              <div class="mt-8 pt-4 border-t border-dashed text-[11px] text-muted-foreground font-semibold flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                Penetapan resmi SK Bupati & Pemdes.
              </div>
            </div>
          ))}
        </div>

        <!-- Pagination UI -->
        {defaultZones.length > 6 && (
          <div id="zona-pagination" class="flex items-center justify-center gap-1.5 pt-8 border-t border-border">
            <button 
              id="zona-prev-btn" 
              class="inline-flex items-center justify-center rounded-xl text-sm font-semibold border bg-background hover:bg-muted text-muted-foreground hover:text-foreground h-10 w-10 transition-colors cursor-pointer disabled:opacity-50 disabled:pointer-events-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <span id="zona-page-info" class="text-xs font-bold text-muted-foreground px-2">Halaman 1 dari 1</span>
            <button 
              id="zona-next-btn" 
              class="inline-flex items-center justify-center rounded-xl text-sm font-semibold border bg-background hover:bg-muted text-muted-foreground hover:text-foreground h-10 w-10 transition-colors cursor-pointer disabled:opacity-50 disabled:pointer-events-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        )}
      </div>
    )}

  </div>
</Layout>

<script>
  const ITEMS_PER_PAGE = 6;
  let currentPage = 1;
  const cards = document.querySelectorAll('.zona-card');
  const totalItems = cards.length;
  const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

  const prevBtn = document.getElementById('zona-prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('zona-next-btn') as HTMLButtonElement;
  const pageInfo = document.getElementById('zona-page-info');

  const updatePagination = () => {
    if (totalItems <= ITEMS_PER_PAGE) return;

    cards.forEach((card, idx) => {
      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;
      if (idx >= start && idx < end) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    if (pageInfo) {
      pageInfo.innerText = `Halaman ${currentPage} dari ${totalPages}`;
    }
    if (prevBtn) {
      prevBtn.disabled = currentPage === 1;
    }
    if (nextBtn) {
      nextBtn.disabled = currentPage === totalPages;
    }
  };

  if (totalItems > ITEMS_PER_PAGE) {
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updatePagination();
        }
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updatePagination();
        }
      });
    }
    updatePagination();
  }
</script>
