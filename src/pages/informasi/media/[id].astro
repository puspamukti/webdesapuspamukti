---
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import { encodeId, decodeId } from '../../../lib/utils';

export async function getStaticPaths() {
  const { data: articles } = await supabase
    .from('berita')
    .select('id')
    .eq('status', 'Terbit');

  return (articles || []).map((art) => ({
    params: { id: encodeId(art.id) },
  }));
}

const { id } = Astro.params;
const dbId = decodeId(id || '');

if (dbId === null) {
  return Astro.redirect('/informasi/media');
}

// Fetch current article
const { data: article } = await supabase
  .from('berita')
  .select('*')
  .eq('id', dbId)
  .single();

if (!article) {
  return Astro.redirect('/informasi/media');
}

// Fetch other latest articles for sidebar
const { data: latestArticles } = await supabase
  .from('berita')
  .select('*')
  .eq('status', 'Terbit')
  .neq('id', article.id)
  .order('created_at', { ascending: false })
  .limit(3);

const otherArticles = latestArticles || [];
---

<Layout title={`${article.judul} - Desa Puspamukti`}>
  <div class="container mx-auto px-4 max-w-screen-xl py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main Content (2 Columns) -->
      <article class="lg:col-span-2 space-y-8">
        <!-- Back Navigation -->
        <a href="/informasi/media" class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Kembali ke Kabar & Pengumuman
        </a>

        <!-- Article Header -->
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-md bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider">
              {article.kategori}
            </span>
            <span class="text-xs text-muted-foreground">{article.tanggal}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-foreground leading-tight">
            {article.judul}
          </h1>
        </div>

        <!-- Banner Image -->
        {article.gambar_url ? (
          <div class="rounded-3xl overflow-hidden border shadow-sm aspect-video bg-muted">
            <img src={article.gambar_url} alt={article.judul} width="800" height="450" fetchpriority="high" class="w-full h-full object-cover" />
          </div>
        ) : (
          <div class="rounded-3xl border bg-muted aspect-video flex items-center justify-center text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
        )}

        <!-- Article content -->
        <div class="prose max-w-none text-foreground text-base sm:text-lg leading-relaxed whitespace-pre-line font-normal pb-8">
          {article.isi}
        </div>

        <!-- Share Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-6 border-t border-b pb-6">
          <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider">Bagikan Artikel:</span>
          
          <!-- WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.judul)}%20-%20${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] text-white text-xs font-bold px-4 py-2 hover:opacity-90 transition-opacity shadow-sm"
          >
            WhatsApp
          </a>

          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-[#1877F2] text-white text-xs font-bold px-4 py-2 hover:opacity-90 transition-opacity shadow-sm"
          >
            Facebook
          </a>

          <!-- Copy Link Button -->
          <button
            id="btn-copy-link"
            class="inline-flex items-center gap-2 rounded-xl border bg-background hover:bg-muted text-foreground text-xs font-bold px-4 py-2 transition-colors shadow-sm cursor-pointer"
          >
            Salin Tautan
          </button>
        </div>
      </article>

      <script>
        const copyBtn = document.getElementById('btn-copy-link');
        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(window.location.href)
              .then(() => {
                const origText = copyBtn.innerText;
                copyBtn.innerText = 'Tautan Tersalin!';
                copyBtn.classList.add('bg-green-500', 'text-white', 'border-transparent');
                setTimeout(() => {
                  copyBtn.innerText = origText;
                  copyBtn.classList.remove('bg-green-500', 'text-white', 'border-transparent');
                }, 2000);
              })
              .catch(err => {
                console.error('Gagal menyalin tautan:', err);
              });
          });
        }
      </script>

      <!-- Sidebar (1 Column) -->
      <aside class="space-y-8">
        <div class="bg-card border rounded-3xl p-6 shadow-sm space-y-6">
          <h3 class="font-bold text-lg text-foreground border-b pb-3">Kabar Terkini Lainnya</h3>
          
          {otherArticles.length === 0 ? (
            <p class="text-sm text-muted-foreground">Tidak ada artikel lain.</p>
          ) : (
            <div class="space-y-4 divide-y divide-border">
              {otherArticles.map((item, idx) => (
                <a href={`/informasi/media/${encodeId(item.id)}`} class="block group pt-4 first:pt-0">
                  <div class="flex gap-4">
                    {item.gambar_url && (
                      <div class="w-16 h-16 rounded-xl bg-muted overflow-hidden shrink-0 border">
                        <img src={item.gambar_url} alt={item.judul} class="w-full h-full object-cover transition-transform group-hover:scale-105" />
                      </div>
                    )}
                    <div class="space-y-1 flex-1">
                      <span class="text-[9px] font-bold text-primary uppercase tracking-wider">{item.kategori}</span>
                      <h4 class="font-bold text-xs sm:text-sm text-foreground group-hover:text-primary transition-colors line-clamp-2 leading-tight">
                        {item.judul}
                      </h4>
                      <span class="text-[10px] text-muted-foreground block">{item.tanggal}</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>

    </div>
  </div>
</Layout>
