---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Fetch wisata list from Supabase
const { data: wisataList, error: fetchError } = await supabase
  .from('wisata')
  .select('*')
  .order('id', { ascending: true });

if (fetchError) {
  console.error("Error fetching wisata from Supabase:", fetchError);
}

const items = wisataList || [];
---

<Layout title="Desa Wisata - Desa Puspamukti">
  <div class="container mx-auto px-4 max-w-screen-xl py-12 md:py-20 space-y-12">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-semibold border-primary/20 bg-primary/10 text-primary mb-2">
        Pesona Alam
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground">Potensi Desa Wisata</h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Jelajahi keindahan alam, budaya lokal, dan kearifan masyarakat yang menjadi daya tarik utama pariwisata di Desa Puspamukti.
      </p>
    </div>

    {items.length === 0 ? (
      <div class="bg-card border rounded-3xl p-12 text-center flex flex-col items-center justify-center space-y-4 max-w-xl mx-auto shadow-sm">
        <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        </div>
        <h3 class="text-xl font-bold text-foreground">Belum Ada Destinasi Wisata</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Saat ini data daya tarik wisata Desa Puspamukti belum dimasukkan. Silakan kembali lagi nanti atau hubungi Administrator desa untuk menambahkan konten pariwisata.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {items.map((item) => (
          <div class="bg-card border rounded-3xl overflow-hidden shadow-sm hover:shadow-lg transition-all group">
            <div class="aspect-[4/3] bg-muted relative overflow-hidden flex items-center justify-center">
              {item.gambar_url ? (
                <img src={item.gambar_url} alt={item.nama} width="400" height="300" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="absolute inset-0 flex flex-col items-center justify-center text-muted-foreground bg-primary/5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                  <span class="text-[10px] mt-2 font-bold uppercase tracking-wider">Belum Ada Foto</span>
                </div>
              )}
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3 gap-3">
                <h3 class="text-xl font-bold group-hover:text-primary transition-colors">{item.nama}</h3>
                <span class="bg-secondary text-secondary-foreground text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider shrink-0">{item.kategori}</span>
              </div>
              <p class="text-muted-foreground text-sm leading-relaxed">{item.deskripsi}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
