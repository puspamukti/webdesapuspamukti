---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dasbor Warga | Desa Puspamukti">
  <!-- Immediate Zero-Delay Auth Guard (Synchronous before DOM parse) -->
  <script is:inline>
    (function() {
      try {
        var session = localStorage.getItem('warga_session');
        if (!session) {
          window.location.replace('/warga/login');
        }
      } catch (e) {
        window.location.replace('/warga/login');
      }
    })();
  </script>

  <main class="container mx-auto px-4 py-8 max-w-screen-xl min-h-[75vh]">
    <!-- Placeholder while checking auth on client-side -->
    <div id="loading-state" class="flex flex-col items-center justify-center h-64 animate-pulse">
      <div class="w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin mb-4"></div>
      <p class="text-muted-foreground font-medium">Memverifikasi Identitas Warga...</p>
    </div>

    <div id="warga-content" class="hidden space-y-8 animate-fade-in">
      
      <!-- Welcome Profile Header -->
      <div class="bg-card border rounded-3xl p-6 md:p-8 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold border border-primary/20">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Akun Warga Terverifikasi
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Selamat Datang, <span id="warga-nama" class="text-primary">Warga</span>!</h1>
            <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-muted-foreground">
              <span class="flex items-center gap-1.5 font-mono">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="14" x="3" y="5" rx="2" ry="2"/><path d="M7 15h4M7 11h.01"/></svg>
                NIK: <strong id="warga-nik" class="text-foreground">Memuat...</strong>
              </span>
              <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                RT/RW: <strong id="warga-rtrw" class="text-foreground">-</strong>
              </span>
            </div>
          </div>
          <button id="logout-btn" class="inline-flex items-center justify-center rounded-xl text-xs font-bold transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 gap-2 shadow-xs whitespace-nowrap cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x1="9" y1="12" y2="12"/></svg>
            Keluar Portal
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center gap-2 border-b border-border pb-3 overflow-x-auto" id="warga-tabs">
        <button data-tab="tab-bansos" class="warga-tab-btn active px-4 py-2.5 rounded-xl bg-primary text-primary-foreground text-xs sm:text-sm font-bold whitespace-nowrap shadow-xs cursor-pointer transition-all flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          Status Bansos & Data Diri
        </button>
        <button data-tab="tab-esurat" class="warga-tab-btn px-4 py-2.5 rounded-xl bg-secondary text-secondary-foreground text-xs sm:text-sm font-bold whitespace-nowrap hover:bg-secondary/80 transition-colors cursor-pointer flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>
          Layanan E-Surat Mandiri
        </button>
        <button data-tab="tab-pengaduan" class="warga-tab-btn px-4 py-2.5 rounded-xl bg-secondary text-secondary-foreground text-xs sm:text-sm font-bold whitespace-nowrap hover:bg-secondary/80 transition-colors cursor-pointer flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Lapor Kades (Aspirasi)
        </button>
        <button data-tab="tab-apbdes" class="warga-tab-btn px-4 py-2.5 rounded-xl bg-secondary text-secondary-foreground text-xs sm:text-sm font-bold whitespace-nowrap hover:bg-secondary/80 transition-colors cursor-pointer flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Transparansi APBDes
        </button>
      </div>

      <!-- TAB 1: BANSOS & DATA DIRI -->
      <div id="tab-bansos" class="tab-pane space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          
          <!-- Status Bantuan Sosial -->
          <div class="md:col-span-6 bg-card border rounded-3xl p-6 md:p-8 shadow-sm flex flex-col justify-between">
            <div class="flex items-center gap-3 border-b pb-4">
              <div class="w-10 h-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-foreground">Status Bantuan Sosial (Bansos)</h2>
                <p class="text-xs text-muted-foreground">Kementerian Sosial & Dana Desa Puspamukti</p>
              </div>
            </div>
            
            <div class="py-8 flex flex-col items-center justify-center text-center space-y-3">
              <span class="text-xs font-bold text-muted-foreground uppercase tracking-widest">Kategori Penerima:</span>
              <div id="status-bansos-badge" class="px-6 py-3 rounded-full text-base sm:text-lg font-extrabold shadow-inner border">
                Memeriksa Status...
              </div>
              <p id="status-bansos-desc" class="text-xs font-medium text-foreground max-w-sm pt-2">
                Memeriksa basis data bantuan sosial...
              </p>
            </div>

            <div class="bg-muted/40 p-3.5 rounded-2xl border text-[11px] text-muted-foreground leading-relaxed">
              🔒 <strong>Kerahasiaan Terjamin:</strong> Data ini bersifat pribadi dan hanya dapat diakses melalui verifikasi NIK Anda.
            </div>
          </div>

          <!-- Data Kependudukan Pribadi -->
          <div class="md:col-span-6 bg-card border rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
            <div class="flex items-center gap-3 border-b pb-4">
              <div class="w-10 h-10 bg-blue-500/10 text-blue-600 rounded-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-foreground">Data Kependudukan Anda</h2>
                <p class="text-xs text-muted-foreground">Sesuai arsip register kependudukan desa</p>
              </div>
            </div>

            <div class="space-y-3 text-xs sm:text-sm">
              <div class="flex justify-between py-2 border-b border-border/50">
                <span class="text-muted-foreground">Nama Lengkap</span>
                <span class="font-bold text-foreground" id="info-nama">-</span>
              </div>
              <div class="flex justify-between py-2 border-b border-border/50">
                <span class="text-muted-foreground">NIK (Nomor Induk)</span>
                <span class="font-mono font-bold text-foreground" id="info-nik">-</span>
              </div>
              <div class="flex justify-between py-2 border-b border-border/50">
                <span class="text-muted-foreground">Tanggal Lahir</span>
                <span class="font-semibold text-foreground" id="info-tgl">-</span>
              </div>
              <div class="flex justify-between py-2 border-b border-border/50">
                <span class="text-muted-foreground">Jenis Kelamin</span>
                <span class="font-semibold text-foreground" id="info-jk">-</span>
              </div>
              <div class="flex justify-between py-2">
                <span class="text-muted-foreground">Wilayah Domisili</span>
                <span class="font-semibold text-foreground">RT/RW <span id="info-rtrw">-</span>, Desa Puspamukti</span>
              </div>
            </div>

            <div class="bg-primary/5 p-3.5 rounded-2xl border border-primary/20 flex items-center justify-between text-xs">
              <span class="font-medium text-foreground">Status PBB (Pajak Bumi & Bangunan)</span>
              <span class="bg-emerald-500/10 text-emerald-700 font-bold px-2.5 py-1 rounded-lg border border-emerald-300">Lunas / Terdata</span>
            </div>
          </div>

        </div>
      </div>

      <!-- TAB 2: LAYANAN E-SURAT MANDIRI -->
      <div id="tab-esurat" class="tab-pane hidden space-y-8">
        
        <!-- Pilihan Surat Cepat -->
        <div class="space-y-4">
          <div>
            <h2 class="text-xl font-bold text-foreground">Ajukan Surat Keterangan Baru</h2>
            <p class="text-xs sm:text-sm text-muted-foreground">Pilih jenis surat yang Anda butuhkan. Data identitas otomatis terisi dari akun warga Anda.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <button class="btn-request-surat flex items-start gap-4 p-5 rounded-2xl border bg-card hover:bg-muted/40 hover:border-primary/40 transition-all text-left shadow-2xs group cursor-pointer" data-jenis="Surat Keterangan Tidak Mampu (SKTM)">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">SKTM (Tidak Mampu)</h3>
                <p class="text-[11px] text-muted-foreground">Untuk keperluan beasiswa pendidikan atau keringanan biaya RS.</p>
              </div>
            </button>

            <button class="btn-request-surat flex items-start gap-4 p-5 rounded-2xl border bg-card hover:bg-muted/40 hover:border-primary/40 transition-all text-left shadow-2xs group cursor-pointer" data-jenis="Surat Keterangan Usaha (SKU)">
              <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">SKU (Keterangan Usaha)</h3>
                <p class="text-[11px] text-muted-foreground">Untuk pengajuan KUR, izin usaha mikro, atau bantuan modal.</p>
              </div>
            </button>

            <button class="btn-request-surat flex items-start gap-4 p-5 rounded-2xl border bg-card hover:bg-muted/40 hover:border-primary/40 transition-all text-left shadow-2xs group cursor-pointer" data-jenis="Surat Pengantar Domisili">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">Pengantar Domisili</h3>
                <p class="text-[11px] text-muted-foreground">Keterangan resmi tempat tinggal di wilayah Desa Puspamukti.</p>
              </div>
            </button>

            <button class="btn-request-surat flex items-start gap-4 p-5 rounded-2xl border bg-card hover:bg-muted/40 hover:border-primary/40 transition-all text-left shadow-2xs group cursor-pointer" data-jenis="Surat Pengantar SKCK">
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">Pengantar SKCK</h3>
                <p class="text-[11px] text-muted-foreground">Untuk melamar pekerjaan, seleksi CPNS, atau kedinasan.</p>
              </div>
            </button>

            <button class="btn-request-surat flex items-start gap-4 p-5 rounded-2xl border bg-card hover:bg-muted/40 hover:border-primary/40 transition-all text-left shadow-2xs group cursor-pointer" data-jenis="Surat Keterangan Belum Menikah">
              <div class="w-10 h-10 rounded-xl bg-pink-500/10 text-pink-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-sm text-foreground group-hover:text-primary transition-colors">Keterangan Belum Menikah</h3>
                <p class="text-[11px] text-muted-foreground">Persyaratan pendaftaran KUA, administrasi kantor, dll.</p>
              </div>
            </button>
          </div>
        </div>

        <!-- Riwayat Permohonan Surat -->
        <div class="bg-card border rounded-3xl shadow-sm overflow-hidden space-y-4">
          <div class="px-6 py-5 border-b bg-muted/20 flex justify-between items-center">
            <div>
              <h3 class="font-bold text-lg text-foreground">Riwayat Permohonan Surat Saya</h3>
              <p class="text-xs text-muted-foreground">Pantau status persetujuan dari Kepala Desa & cetak surat mandiri</p>
            </div>
            <button id="refresh-surat-btn" class="p-2 rounded-xl hover:bg-muted text-muted-foreground cursor-pointer" title="Perbarui Data">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="bg-muted/50 text-muted-foreground font-semibold border-b">
                <tr>
                  <th class="px-6 py-3.5">Jenis Surat</th>
                  <th class="px-6 py-3.5">Keperluan</th>
                  <th class="px-6 py-3.5">Tanggal Pengajuan</th>
                  <th class="px-6 py-3.5">Status</th>
                  <th class="px-6 py-3.5 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y" id="warga-surat-tbody">
                <tr>
                  <td colspan="5" class="px-6 py-8 text-center text-muted-foreground">
                    Memuat riwayat permohonan surat Anda...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- TAB 3: LAPOR KADES (ASPIRASI & PENGADUAN) -->
      <div id="tab-pengaduan" class="tab-pane hidden space-y-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Form Lapor Kades -->
          <div class="lg:col-span-5 bg-card border rounded-3xl p-6 md:p-8 shadow-sm space-y-5">
            <div class="border-b pb-4 space-y-1">
              <h2 class="text-xl font-bold text-foreground">Sampaikan Aspirasi / Laporan</h2>
              <p class="text-xs text-muted-foreground">Identitas Anda terproteksi aman dan ditangani langsung oleh Pemdes.</p>
            </div>

            <form id="warga-pengaduan-form" class="space-y-4" novalidate>
              <div class="space-y-1.5 text-left">
                <label for="lapor-kategori" class="text-xs font-bold text-foreground uppercase tracking-wider">Kategori Laporan</label>
                <select id="lapor-kategori" class="flex h-11 w-full rounded-xl border border-input bg-background px-3 py-2 text-xs sm:text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer" required>
                  <option value="Jalan & Infrastruktur">Jalan & Infrastruktur Rusak</option>
                  <option value="Bantuan Sosial (Bansos)">Kendala Bansos / DTKS</option>
                  <option value="Pelayanan Publik Desa">Pelayanan Balai Desa</option>
                  <option value="Kebersihan & Lingkungan">Kebersihan & Lingkungan</option>
                  <option value="Lainnya">Lain-lain / Aspirasi Umum</option>
                </select>
              </div>

              <div class="space-y-1.5 text-left">
                <label for="lapor-isi" class="text-xs font-bold text-foreground uppercase tracking-wider">Uraian Masalah / Usulan</label>
                <textarea 
                  id="lapor-isi" 
                  rows="4" 
                  placeholder="Tuliskan secara jelas lokasi, kendala, atau saran pembangunan untuk desa kita..."
                  class="flex w-full rounded-xl border border-input bg-background px-3 py-2 text-xs sm:text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary resize-none shadow-2xs transition-colors"
                  required
                ></textarea>
                <p id="lapor-isi-error" class="hidden text-xs text-destructive font-medium mt-1 flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                  <span>Uraian laporan wajib diisi minimal 10 karakter.</span>
                </p>
              </div>

              <button type="submit" id="submit-lapor-btn" class="w-full inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 h-11 text-xs font-bold shadow-md hover:shadow-lg gap-2 cursor-pointer transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                Kirim Laporan ke Kades
              </button>
            </form>
          </div>

          <!-- Riwayat Pengaduan Saya -->
          <div class="lg:col-span-7 bg-card border rounded-3xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b bg-muted/20">
              <h3 class="font-bold text-lg text-foreground">Riwayat Laporan Saya</h3>
              <p class="text-xs text-muted-foreground">Daftar aspirasi yang telah Anda kirimkan</p>
            </div>

            <div class="divide-y" id="warga-pengaduan-list">
              <div class="p-6 text-center text-xs text-muted-foreground">
                Memuat riwayat laporan Anda...
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- TAB 4: TRANSPARANSI APBDES (KHUSUS WARGA) -->
      <div id="tab-apbdes" class="tab-pane hidden space-y-6">
        <div class="bg-card border rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b gap-4">
            <div>
              <h2 class="text-xl font-bold text-foreground flex items-center gap-2">
                <span>📊</span> Transparansi Anggaran Desa (APBDes)
              </h2>
