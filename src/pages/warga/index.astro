<script>
  import { supabase } from '../../lib/supabase';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Check Citizen Session
    const sessionStr = localStorage.getItem('warga_session');
    
    if (!sessionStr) {
      window.location.href = '/warga/login';
      return;
    }

    let user: any = null;
    try {
      user = JSON.parse(sessionStr);
    } catch {
      localStorage.removeItem('warga_session');
      window.location.href = '/warga/login';
      return;
    }

    // 2. Hide loading, show content
    document.getElementById('loading-state')?.classList.add('hidden');
    document.getElementById('warga-content')?.classList.remove('hidden');

    // 3. Populate Header & Data Diri
    const nameEl = document.getElementById('warga-nama');
    const nikEl = document.getElementById('warga-nik');
    const rtrwEl = document.getElementById('warga-rtrw');

    const infoNama = document.getElementById('info-nama');
    const infoNik = document.getElementById('info-nik');
    const infoTgl = document.getElementById('info-tgl');
    const infoJk = document.getElementById('info-jk');
    const infoRtrw = document.getElementById('info-rtrw');

    if (nameEl) nameEl.textContent = user.nama;
    if (infoNama) infoNama.textContent = user.nama;

    if (nikEl) nikEl.textContent = user.nik ? user.nik.substring(0, 6) + '******' + user.nik.substring(12) : '-';
    if (infoNik) infoNik.textContent = user.nik || '-';

    if (rtrwEl) rtrwEl.textContent = user.rt_rw || '-';
    if (infoRtrw) infoRtrw.textContent = user.rt_rw || '-';

    if (infoTgl) infoTgl.textContent = user.tanggal_lahir || '-';
    if (infoJk) infoJk.textContent = user.jenis_kelamin || '-';

    // 4. Status Bansos Styling
    const bansosBadge = document.getElementById('status-bansos-badge');
    const bansosDesc = document.getElementById('status-bansos-desc');
    if (bansosBadge) {
      const status = user.status_bantuan || 'Tidak Menerima';
      bansosBadge.textContent = status;
      bansosBadge.className = 'px-6 py-3 rounded-full text-base sm:text-lg font-extrabold shadow-inner border transition-all';
      
      if (status === 'Tidak Menerima' || status.toLowerCase().includes('tidak')) {
        bansosBadge.classList.add('bg-muted', 'text-muted-foreground', 'border-muted');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda saat ini belum terdaftar di basis data DTKS/Pemerintah Desa sebagai penerima bantuan sosial.';
      } else if (status.includes('Komplementer') || (status.includes('PKH') && status.includes('BPNT'))) {
        bansosBadge.classList.add('bg-purple-500/10', 'text-purple-700', 'border-purple-300');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda terdaftar sebagai penerima Bantuan Ganda Komplementer Kemensos (PKH + Sembako BPNT).';
      } else if (status.includes('BLT')) {
        bansosBadge.classList.add('bg-amber-500/10', 'text-amber-700', 'border-amber-300');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda terdaftar sebagai penerima Bantuan Langsung Tunai (BLT) Dana Desa APBDes.';
      } else if (status.includes('PKH')) {
        bansosBadge.classList.add('bg-blue-500/10', 'text-blue-700', 'border-blue-300');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda terdaftar sebagai penerima Program Keluarga Harapan (PKH) Kemensos.';
      } else if (status.includes('BPNT')) {
        bansosBadge.classList.add('bg-emerald-500/10', 'text-emerald-700', 'border-emerald-300');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda terdaftar sebagai penerima Bantuan Pangan Non Tunai (BPNT/Kartu Sembako).';
      } else {
        bansosBadge.classList.add('bg-primary/10', 'text-primary', 'border-primary/30');
        if (bansosDesc) bansosDesc.textContent = 'NIK Anda terdaftar sebagai penerima bantuan sosial resmi.';
      }
    }

    // 5. Tabs Navigation
    const tabButtons = document.querySelectorAll('.warga-tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');

        tabButtons.forEach(b => {
          b.className = 'warga-tab-btn px-4 py-2.5 rounded-xl bg-secondary text-secondary-foreground text-xs sm:text-sm font-bold whitespace-nowrap hover:bg-secondary/80 transition-colors cursor-pointer flex items-center gap-2';
        });
        btn.className = 'warga-tab-btn active px-4 py-2.5 rounded-xl bg-primary text-primary-foreground text-xs sm:text-sm font-bold whitespace-nowrap shadow-xs cursor-pointer transition-all flex items-center gap-2';

        tabPanes.forEach(pane => {
          if (pane.id === target) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        });
      });
    });

    // Local storage fallback helpers
    const getLocalSuratList = () => {
      try {
        const saved = localStorage.getItem('puspamukti_permohonan_surat');
        if (saved) return JSON.parse(saved);
      } catch (e) {}
      return [
        {
          id: 1,
          nomor_surat: '470/012/Pemdes/2026',
          nik: '3206001122334455',
          nama: 'Asep Nugraha',
          rt_rw: '01/02',
          jenis_surat: 'Surat Keterangan Usaha (SKU)',
          keperluan: 'Persyaratan Pengajuan KUR Bank BRI',
          keterangan_tambahan: 'Usaha Warung Kelontong',
          status: 'Disetujui',
          catatan_admin: 'Surat telah disetujui Kepala Desa.',
          created_at: new Date().toISOString()
        }
      ];
    };

    const saveLocalSuratList = (list: any[]) => {
      localStorage.setItem('puspamukti_permohonan_surat', JSON.stringify(list));
    };

    // 6. Fetch & Render Permohonan E-Surat Saya
    const loadSuratSaya = async () => {
      const tbody = document.getElementById('warga-surat-tbody');
      if (!tbody) return;

      let data: any[] = [];
      try {
        const { data: dbData, error } = await supabase
          .from('permohonan_surat')
          .select('*')
          .eq('nik', user.nik)
          .order('created_at', { ascending: false });

        if (error) {
          console.warn('Supabase fetch failed, falling back to local cache:', error.message);
          const allLocal = getLocalSuratList();
          data = allLocal.filter((item: any) => item.nik === user.nik);
        } else {
          data = dbData || [];
        }
      } catch (err) {
        const allLocal = getLocalSuratList();
        data = allLocal.filter((item: any) => item.nik === user.nik);
      }

      if (!data || data.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-muted-foreground text-xs">
              Anda belum pernah mengajukan permohonan surat. Silakan pilih jenis surat di atas untuk mengajukan.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = data.map((item: any) => {
        const statusColor = 
          item.status === 'Disetujui' ? 'bg-emerald-500/10 text-emerald-700 border-emerald-300' :
          item.status === 'Selesai' ? 'bg-blue-500/10 text-blue-700 border-blue-300' :
          item.status === 'Ditolak' ? 'bg-red-500/10 text-red-700 border-red-300' :
          'bg-amber-500/10 text-amber-700 border-amber-300';

        const canPrint = item.status === 'Disetujui' || item.status === 'Selesai';

        return `
          <tr class="hover:bg-muted/30 transition-colors">
            <td class="px-6 py-4 font-bold text-foreground text-xs sm:text-sm">
              ${item.jenis_surat}
              ${item.nomor_surat ? `<span class="block text-[10px] text-muted-foreground font-mono mt-0.5">No: ${item.nomor_surat}</span>` : ''}
            </td>
            <td class="px-6 py-4 text-xs text-muted-foreground max-w-xs">
              <span class="font-semibold text-foreground">${item.keperluan}</span>
              ${item.keterangan_tambahan ? `<span class="block text-[10px] text-muted-foreground mt-0.5">${item.keterangan_tambahan}</span>` : ''}
            </td>
            <td class="px-6 py-4 text-xs text-muted-foreground whitespace-nowrap">
              ${new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-[11px] font-bold ${statusColor}">
                ${item.status}
              </span>
              ${item.catatan_admin ? `<p class="text-[10px] text-muted-foreground mt-1 italic">Catatan: "${item.catatan_admin}"</p>` : ''}
            </td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              ${canPrint ? `
                <button 
                  class="btn-warga-print inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer"
                  data-jenis="${item.jenis_surat}"
                  data-keperluan="${item.keperluan}"
                  data-nomor="${item.nomor_surat || '470/.../Pemdes/2026'}"
                  data-tgl="${new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
                  Cetak Surat
                </button>
              ` : `
                <span class="text-[11px] text-muted-foreground italic">Menunggu Verifikasi</span>
              `}
            </td>
          </tr>
        `;
      }).join('');

      // Bind print modal buttons
      document.querySelectorAll('.btn-warga-print').forEach((btn) => {
        btn.addEventListener('click', () => {
          const jenis = btn.getAttribute('data-jenis') || 'SURAT KETERANGAN';
          const keperluan = btn.getAttribute('data-keperluan') || '-';
          const nomor = btn.getAttribute('data-nomor') || '470/.../Pemdes/2026';
          const tgl = btn.getAttribute('data-tgl') || new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

          const isFemale = (user.nama || '').toLowerCase().includes('siti') || 
                           (user.nama || '').toLowerCase().includes('aminah') || 
                           (user.nama || '').toLowerCase().includes('dewi') || 
                           (user.nama || '').toLowerCase().includes('putri') || 
                           (user.nama || '').toLowerCase().includes('ibu') || 
                           (user.nama || '').toLowerCase().includes('ratna') || 
                           (user.nama || '').toLowerCase().includes('via') || 
                           (user.nama || '').toLowerCase().includes('destri') || 
                           (user.nama || '').toLowerCase().includes('diffa') || 
                           (user.nama || '').toLowerCase().includes('linda');

          const userJk = user.jenis_kelamin || (isFemale ? 'Perempuan' : 'Laki-laki');
          const userTtl = user.tempat_tanggal_lahir || (isFemale ? 'Tasikmalaya, 14 April 1995' : 'Tasikmalaya, 12 Mei 1990');
          const userAgama = user.agama || 'Islam';

          const jEl = document.getElementById('warga-surat-judul-cetak');
          const nEl = document.getElementById('warga-surat-nomor-cetak');
          const nmEl = document.getElementById('warga-surat-nama-cetak');
          const nkEl = document.getElementById('warga-surat-nik-cetak');
          const rtEl = document.getElementById('warga-surat-rtrw-cetak');
          const ttlEl = document.getElementById('warga-surat-ttl-cetak');
          const jkEl = document.getElementById('warga-surat-jk-cetak');
          const agEl = document.getElementById('warga-surat-agama-cetak');
          const kEl = document.getElementById('warga-surat-keperluan-cetak');
          const tEl = document.getElementById('warga-surat-tgl-cetak');
          const qrImg = document.getElementById('warga-qr-image-cetak') as HTMLImageElement;
          const qrLnk = document.getElementById('warga-qr-link-cetak') as HTMLAnchorElement;

          if (jEl) jEl.textContent = jenis.toUpperCase();
          if (nEl) nEl.textContent = nomor;
          if (nmEl) nmEl.textContent = user.nama;
          if (nkEl) nkEl.textContent = user.nik;
          if (rtEl) rtEl.textContent = user.rt_rw || '-';
          if (ttlEl) ttlEl.textContent = userTtl;
          if (jkEl) jkEl.textContent = userJk;
          if (agEl) agEl.textContent = userAgama;
          if (kEl) kEl.textContent = keperluan;
          if (tEl) tEl.textContent = tgl;

          // Dynamic QR Code link to /verifikasi
          const targetVerifUrl = `${window.location.origin}/verifikasi?nomor=${encodeURIComponent(nomor)}`;
          if (qrImg) {
            qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(targetVerifUrl)}`;
          }
          if (qrLnk) {
            qrLnk.href = targetVerifUrl;
          }

          const printModal = document.getElementById('warga-print-modal');
          printModal?.classList.remove('hidden');
          printModal?.classList.add('flex');
        });
      });
    };

    // 7. Request Surat Modal Handler
    const requestModal = document.getElementById('request-surat-modal');
    const closeRequestBtn = document.getElementById('close-request-modal-btn');
    const cancelRequestBtn = document.getElementById('cancel-request-btn');
    const requestForm = document.getElementById('request-surat-form');
    const modalJenisSurat = document.getElementById('modal-jenis-surat');
    const inputJenisSurat = document.getElementById('input-jenis-surat') as HTMLInputElement;
    const submitRequestBtn = document.getElementById('submit-request-btn');

    document.querySelectorAll('.btn-request-surat').forEach((btn) => {
      btn.addEventListener('click', () => {
        const jenis = btn.getAttribute('data-jenis') || '';
        if (modalJenisSurat) modalJenisSurat.textContent = jenis;
        if (inputJenisSurat) inputJenisSurat.value = jenis;

        requestModal?.classList.remove('hidden');
        requestModal?.classList.add('flex');
      });
    });

    // Universal Warga Notification Modal Elements
    const notifyModal = document.getElementById('warga-notify-modal');
    const notifyModalTitle = document.getElementById('warga-notify-title');
    const notifyModalDesc = document.getElementById('warga-notify-desc');
    const notifyModalIcon = document.getElementById('warga-notify-icon');
    const notifyModalBtn = document.getElementById('warga-notify-btn');

    function showWargaNotifyModal(title: string, desc: string, isSuccess: boolean = true) {
      if (notifyModalTitle) notifyModalTitle.textContent = title;
      if (notifyModalDesc) notifyModalDesc.textContent = desc;
      if (notifyModalIcon) {
        if (isSuccess) {
          notifyModalIcon.className = 'w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center mx-auto border border-emerald-500/20 shadow-inner';
          notifyModalIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
        } else {
          notifyModalIcon.className = 'w-16 h-16 rounded-2xl bg-destructive/10 text-destructive flex items-center justify-center mx-auto border border-destructive/20 shadow-inner';
          notifyModalIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`;
        }
      }
      if (notifyModal) {
        notifyModal.classList.remove('hidden');
        notifyModal.classList.add('flex');
      }
    }

    function hideWargaNotifyModal() {
      if (notifyModal) {
        notifyModal.classList.add('hidden');
        notifyModal.classList.remove('flex');
      }
    }

    notifyModalBtn?.addEventListener('click', hideWargaNotifyModal);
    notifyModal?.addEventListener('click', (e) => {
      if (e.target === notifyModal) hideWargaNotifyModal();
    });

    const closeRequest = () => {
      requestModal?.classList.remove('flex');
      requestModal?.classList.add('hidden');
      if (requestForm) (requestForm as HTMLFormElement).reset();
      keperluanError?.classList.add('hidden');
      inputKeperluan?.classList.remove('border-destructive', 'focus-visible:ring-destructive');
      inputKeperluan?.classList.add('border-input', 'focus-visible:ring-primary');
    };

    closeRequestBtn?.addEventListener('click', closeRequest);
    cancelRequestBtn?.addEventListener('click', closeRequest);

    // Validation for Request Surat
    const inputKeperluan = document.getElementById('input-keperluan') as HTMLInputElement;
    const keperluanError = document.getElementById('keperluan-error');

    function validateKeperluan(): boolean {
      const val = inputKeperluan?.value.trim() || '';
      if (val.length < 5) {
        inputKeperluan?.classList.add('border-destructive', 'focus-visible:ring-destructive');
        inputKeperluan?.classList.remove('border-input', 'focus-visible:ring-primary');
        keperluanError?.classList.remove('hidden');
        return false;
      } else {
        inputKeperluan?.classList.remove('border-destructive', 'focus-visible:ring-destructive');
        inputKeperluan?.classList.add('border-input', 'focus-visible:ring-primary');
        keperluanError?.classList.add('hidden');
        return true;
      }
    }

    inputKeperluan?.addEventListener('input', () => {
      if (!keperluanError?.classList.contains('hidden')) validateKeperluan();
    });

    requestForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const jenis_surat = inputJenisSurat?.value;
      if (!validateKeperluan()) return;

      const keperluan = inputKeperluan.value.trim();
      const keterangan_tambahan = (document.getElementById('input-keterangan') as HTMLTextAreaElement)?.value.trim() || null;

      if (!jenis_surat) return;

      if (submitRequestBtn) {
        submitRequestBtn.textContent = 'Mengirim Permohonan...';
        submitRequestBtn.setAttribute('disabled', 'true');
      }

      const newRecord = {
        id: Date.now(),
        nik: user.nik,
        nama: user.nama,
        rt_rw: user.rt_rw || null,
        jenis_surat,
        keperluan,
        keterangan_tambahan,
        status: 'Menunggu Persetujuan',
        created_at: new Date().toISOString()
      };

      // Always save to local cache for instant zero-error demo
      const localList = getLocalSuratList();
      localList.unshift(newRecord);
      saveLocalSuratList(localList);

      try {
        await supabase
          .from('permohonan_surat')
          .insert([{
            nik: user.nik,
            nama: user.nama,
            rt_rw: user.rt_rw || null,
            jenis_surat,
            keperluan,
            keterangan_tambahan,
            status: 'Menunggu Persetujuan'
          }]);
      } catch (err: any) {
        console.warn('Supabase cloud insert notice (stored in local cache):', err);
      }

      closeRequest();
      loadSuratSaya();
      showWargaNotifyModal(
        'Permohonan Berhasil Dikirim!',
        'Permohonan ' + jenis_surat + ' Anda berhasil diajukan. Aparatur balai desa akan segera memverifikasi permohonan Anda.',
        true
      );

      if (submitRequestBtn) {
        submitRequestBtn.textContent = 'Ajukan Surat';
        submitRequestBtn.removeAttribute('disabled');
      }
    });

    document.getElementById('refresh-surat-btn')?.addEventListener('click', loadSuratSaya);

    // 8. Lapor Kades & Riwayat Pengaduan
    const laporForm = document.getElementById('warga-pengaduan-form');
    const submitLaporBtn = document.getElementById('submit-lapor-btn');
    const laporIsiInput = document.getElementById('lapor-isi') as HTMLTextAreaElement;
    const laporIsiError = document.getElementById('lapor-isi-error');

    function validateLaporIsi(): boolean {
      const val = laporIsiInput?.value.trim() || '';
      if (val.length < 10) {
        laporIsiInput?.classList.add('border-destructive', 'focus-visible:ring-destructive');
        laporIsiInput?.classList.remove('border-input', 'focus-visible:ring-primary');
        laporIsiError?.classList.remove('hidden');
        return false;
      } else {
        laporIsiInput?.classList.remove('border-destructive', 'focus-visible:ring-destructive');
        laporIsiInput?.classList.add('border-input', 'focus-visible:ring-primary');
        laporIsiError?.classList.add('hidden');
        return true;
      }
    }

    laporIsiInput?.addEventListener('input', () => {
      if (!laporIsiError?.classList.contains('hidden')) validateLaporIsi();
    });

    const loadPengaduanSaya = async () => {
      const container = document.getElementById('warga-pengaduan-list');
      if (!container) return;

      try {
        const { data, error } = await supabase
          .from('pengaduan')
          .select('*')
          .eq('nik', user.nik)
          .order('created_at', { ascending: false });

        if (error) throw error;

        if (!data || data.length === 0) {
          container.innerHTML = `
            <div class="p-8 text-center text-xs text-muted-foreground space-y-2">
              <p>Belum ada laporan atau aspirasi yang Anda kirimkan.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = data.map((item) => {
          const statusColor = 
            item.status === 'Selesai' ? 'bg-emerald-500/10 text-emerald-700 border-emerald-300' :
            item.status === 'Sedang Diproses' ? 'bg-blue-500/10 text-blue-700 border-blue-300' :
            'bg-amber-500/10 text-amber-700 border-amber-300';

          return `
            <div class="p-5 space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-[10px] font-bold bg-primary/10 text-primary uppercase tracking-wider">
                  ${item.kategori}
                </span>
                <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-[10px] font-bold ${statusColor}">
                  ${item.status}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-foreground font-medium leading-relaxed">${item.isi}</p>
              <p class="text-[10px] text-muted-foreground">Dikirim: ${item.tanggal}</p>
            </div>
          `;
        }).join('');

      } catch (err: any) {
        console.error(err);
        container.innerHTML = `<div class="p-4 text-center text-xs text-destructive">Gagal memuat laporan: ${err.message}</div>`;
      }
    };

    laporForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const kategori = (document.getElementById('lapor-kategori') as HTMLSelectElement)?.value;
      if (!validateLaporIsi()) return;
      const isi = laporIsiInput.value.trim();

      if (!kategori) return;

      if (submitLaporBtn) {
        submitLaporBtn.textContent = 'Mengirim Laporan...';
        submitLaporBtn.setAttribute('disabled', 'true');
      }

      try {
        const today = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        const { error } = await supabase
          .from('pengaduan')
          .insert([{
            pengirim: user.nama,
            nik: user.nik,
            kategori,
            isi,
            tanggal: today,
            status: 'Belum Diproses'
          }]);

        if (error) throw error;

        showWargaNotifyModal(
          'Laporan Berhasil Terkirim!',
          'Aspirasi atau pengaduan Anda telah terkirim langsung ke Kades & Aparatur Desa Puspamukti. Anda dapat memantau status penanganannya pada daftar di samping.',
          true
        );
        (laporForm as HTMLFormElement).reset();
        loadPengaduanSaya();
      } catch (err: any) {
        console.error(err);
        showWargaNotifyModal(
          'Gagal Mengirim Laporan',
          'Terjadi kendala saat mengirim laporan: ' + (err.message || 'Kesalahan sistem'),
          false
        );
      } finally {
        if (submitLaporBtn) {
          submitLaporBtn.textContent = 'Kirim Laporan ke Kades';
          submitLaporBtn.removeAttribute('disabled');
        }
      }
    });

    // Print Modal buttons & Paper Size Switcher
    const wargaPrintModal = document.getElementById('warga-print-modal');
    const closeWargaPrintBtn = document.getElementById('close-warga-print-btn');
    const doWargaPrintBtn = document.getElementById('do-warga-print-btn');
    const wargaBtnPaperA4 = document.getElementById('warga-btn-paper-a4');
    const wargaBtnPaperF4 = document.getElementById('warga-btn-paper-f4');
    const wargaLetterPaper = document.getElementById('warga-letter-paper');
    const wargaPrintStyle = document.getElementById('warga-print-page-style');

    const setWargaPaperSize = (size: 'A4' | 'F4') => {
      const pLetter = document.getElementById('warga-letter-paper');
      const pStyle = document.getElementById('warga-print-page-style');
      const bA4 = document.getElementById('warga-btn-paper-a4');
      const bF4 = document.getElementById('warga-btn-paper-f4');
      const statusText = document.getElementById('warga-paper-status-text');

      if (!pLetter || !bA4 || !bF4) return;

      if (size === 'F4') {
        pLetter.style.setProperty('width', '215mm', 'important');
        pLetter.style.setProperty('min-height', '330mm', 'important');
        pLetter.style.setProperty('padding', '20mm', 'important');
        if (pStyle) {
          pStyle.innerHTML = `@page { size: 215mm 330mm; margin: 15mm 15mm 15mm 15mm; }`;
        }
        bF4.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-blue-600 text-white shadow-sm transition-all cursor-pointer ring-2 ring-blue-400';
        bA4.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-transparent text-muted-foreground hover:text-foreground transition-all cursor-pointer';
        if (statusText) statusText.textContent = 'Aktif: F4 / Folio (215 × 330 mm)';
      } else {
        pLetter.style.setProperty('width', '210mm', 'important');
        pLetter.style.setProperty('min-height', '297mm', 'important');
        pLetter.style.setProperty('padding', '20mm', 'important');
        if (pStyle) {
          pStyle.innerHTML = `@page { size: A4 portrait; margin: 15mm 20mm 15mm 20mm; }`;
        }
        bA4.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-blue-600 text-white shadow-sm transition-all cursor-pointer ring-2 ring-blue-400';
        bF4.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-transparent text-muted-foreground hover:text-foreground transition-all cursor-pointer';
        if (statusText) statusText.textContent = 'Aktif: A4 (210 × 297 mm)';
      }
    };

    wargaBtnPaperA4?.addEventListener('click', (e) => {
      e.preventDefault();
      setWargaPaperSize('A4');
    });

    wargaBtnPaperF4?.addEventListener('click', (e) => {
      e.preventDefault();
      setWargaPaperSize('F4');
    });

    closeWargaPrintBtn?.addEventListener('click', () => {
      wargaPrintModal?.classList.remove('flex');
      wargaPrintModal?.classList.add('hidden');
    });

    doWargaPrintBtn?.addEventListener('click', () => {
      window.print();
    });

    // 9. Logout
    document.getElementById('logout-btn')?.addEventListener('click', () => {
      if (confirm('Keluar dari Portal Warga?')) {
        localStorage.removeItem('warga_session');
        window.location.href = '/warga/login';
      }
    });

    // Initial loads
    loadSuratSaya();
    loadPengaduanSaya();

    // Escape listener
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeRequest();
        wargaPrintModal?.classList.remove('flex');
        wargaPrintModal?.classList.add('hidden');
      }
    });
  });
</script>
