---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch budget transparency data (APBDes)
const { data: anggaran } = await supabase
  .from('apbdes')
  .select('*')
  .order('tahun', { ascending: false });
---

<Layout title="Transparansi Anggaran (APBDes) | Desa Puspamukti">
  <main class="container mx-auto px-4 py-12 max-w-screen-xl min-h-[75vh]">
    
    <!-- State 1: Locked Gate for General Public -->
    <div id="transparansi-locked" class="hidden max-w-2xl mx-auto text-center py-16 px-6 bg-card border rounded-3xl shadow-xl space-y-6 animate-fade-in">
      <div class="w-20 h-20 bg-primary/10 text-primary rounded-3xl flex items-center justify-center mx-auto shadow-inner border border-primary/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 text-xs font-bold border border-amber-500/20">
          <span>🔒</span> Akses Terbatas Khusus Warga Desa
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-foreground tracking-tight">
          Transparansi Anggaran <span class="text-primary">(APBDes)</span>
        </h1>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-lg mx-auto">
          Sesuai kebijakan Pemerintah Desa Puspamukti, rincian transparansi realisasi APBDes dan alokasi Dana Desa diperuntukkan secara khusus bagi <strong>Warga Masyarakat yang memiliki NIK Desa Puspamukti</strong>.
        </p>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/warga/login" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary text-primary-foreground text-sm font-bold shadow-md hover:bg-primary/90 transition-all cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x1="3" y1="12" y2="12"/></svg>
          Masuk dengan NIK Warga
        </a>
        <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border bg-card text-foreground text-sm font-semibold hover:bg-accent transition-all cursor-pointer">
          Kembali ke Beranda
        </a>
      </div>

      <p class="text-[11px] text-muted-foreground pt-2">
        Belum memiliki akun warga? Hubungi Kantor Desa Puspamukti atau Ketua RT setempat.
      </p>
    </div>

    <!-- State 2: Unlocked Budget for Logged In Citizen / Admin -->
    <div id="transparansi-unlocked" class="hidden space-y-12 animate-fade-in">
      
      <!-- Verified Citizen Banner -->
      <div class="bg-primary/10 border border-primary/20 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <div class="text-xs font-bold text-primary uppercase tracking-wider">Akses Terbuka & Terverifikasi</div>
            <div class="text-sm font-bold text-foreground">Halo, <span id="budget-user-name">Warga Puspamukti</span>! Anda memiliki hak penuh memantau APBDes.</div>
          </div>
        </div>
        <a href="/warga" class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-card border text-xs font-bold hover:bg-accent transition-colors shadow-2xs shrink-0">
          <span>👤</span> Kembali ke Portal Warga
        </a>
      </div>

      <div class="text-center max-w-3xl mx-auto animate-slide-up">
        <h1 class="text-3xl md:text-5xl font-extrabold text-foreground tracking-tight mb-4">
          Transparansi <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60">Anggaran Desa</span>
        </h1>
        <p class="text-muted-foreground text-sm sm:text-base">
          Laporan resmi pertanggungjawaban dan alokasi Anggaran Pendapatan dan Belanja Desa (APBDes) Pemerintah Desa Puspamukti.
        </p>
      </div>
      
      {anggaran && anggaran.length > 0 ? (
        <div class="space-y-12">
          {anggaran.map((item, index) => {
            const totalPendapatan = (item.pendapatan_asli_desa || 0) + (item.dana_desa || 0) + (item.alokasi_dana_desa || 0) + (item.bantuan_provinsi || 0) + (item.bantuan_kabupaten || 0) + (item.pendapatan_lain || 0);
            const totalBelanja = (item.belanja_pegawai || 0) + (item.belanja_barang_jasa || 0) + (item.belanja_modal || 0) + (item.belanja_tak_terduga || 0);
            const isLatest = index === 0;

            return (
              <div class={`bg-card rounded-3xl overflow-hidden border shadow-sm ${isLatest ? 'ring-1 ring-primary/20 shadow-md' : ''}`}>
                <div class="bg-muted/30 px-6 py-4 border-b flex justify-between items-center">
                  <h2 class="text-xl font-bold text-foreground">APBDes Tahun {item.tahun} {isLatest && <span class="ml-2 inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Terbaru</span>}</h2>
                  <div class="text-sm font-medium text-muted-foreground">Sisa Saldo: <span class={totalPendapatan - totalBelanja >= 0 ? "text-green-600 font-bold" : "text-red-600 font-bold"}>Rp {(totalPendapatan - totalBelanja).toLocaleString('id-ID')}</span></div>
                </div>

                <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
                  <!-- PENDAPATAN -->
                  <div>
                    <div class="flex justify-between items-end mb-4 border-b pb-2">
                      <h3 class="text-lg font-bold text-primary flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        Pendapatan Desa
                      </h3>
                      <span class="text-lg font-extrabold text-foreground">Rp {totalPendapatan.toLocaleString('id-ID')}</span>
                    </div>
                    
                    <ul class="space-y-3">
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Pendapatan Asli Desa (PAD)</span>
                        <span class="font-semibold">Rp {(item.pendapatan_asli_desa || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Dana Desa (DD)</span>
                        <span class="font-semibold">Rp {(item.dana_desa || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Alokasi Dana Desa (ADD)</span>
                        <span class="font-semibold">Rp {(item.alokasi_dana_desa || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Bantuan Provinsi</span>
                        <span class="font-semibold">Rp {(item.bantuan_provinsi || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Bantuan Kabupaten</span>
                        <span class="font-semibold">Rp {(item.bantuan_kabupaten || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Pendapatan Lain-lain</span>
                        <span class="font-semibold">Rp {(item.pendapatan_lain || 0).toLocaleString('id-ID')}</span>
                      </li>
                    </ul>
                  </div>

                  <!-- BELANJA -->
                  <div>
                    <div class="flex justify-between items-end mb-4 border-b pb-2">
                      <h3 class="text-lg font-bold text-destructive flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
                        Belanja Desa
                      </h3>
                      <span class="text-lg font-extrabold text-foreground">Rp {totalBelanja.toLocaleString('id-ID')}</span>
                    </div>
                    
                    <ul class="space-y-3">
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Belanja Pegawai (Siltap & Tunjangan)</span>
                        <span class="font-semibold">Rp {(item.belanja_pegawai || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Belanja Barang & Jasa</span>
                        <span class="font-semibold">Rp {(item.belanja_barang_jasa || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Belanja Modal (Infrastruktur & Jalan)</span>
                        <span class="font-semibold">Rp {(item.belanja_modal || 0).toLocaleString('id-ID')}</span>
                      </li>
                      <li class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Belanja Tak Terduga (Darurat/Bencana)</span>
                        <span class="font-semibold">Rp {(item.belanja_tak_terduga || 0).toLocaleString('id-ID')}</span>
                      </li>
                    </ul>
                  </div>
                </div>
                
                {item.gambar_infografis_url && (
                  <div class="px-6 pb-6 pt-2">
                    <a href={item.gambar_infografis_url} target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                      Lihat Poster Infografis Lengkap
                    </a>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12 bg-card border rounded-3xl shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-muted-foreground mb-4"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <h3 class="text-xl font-bold mb-2">Data Belum Tersedia</h3>
          <p class="text-muted-foreground">Pemerintah desa belum mempublikasikan data transparansi anggaran pada saat ini.</p>
        </div>
      )}
    </div>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wargaSessionStr = localStorage.getItem('warga_session');
    const adminSessionStr = localStorage.getItem('admin_session');

    const lockedEl = document.getElementById('transparansi-locked');
    const unlockedEl = document.getElementById('transparansi-unlocked');
    const userNameEl = document.getElementById('budget-user-name');

    if (wargaSessionStr || adminSessionStr) {
      // Citizen or Admin is authenticated -> show full budget
      if (wargaSessionStr) {
        try {
          const user = JSON.parse(wargaSessionStr);
          if (userNameEl && user.nama) {
            userNameEl.textContent = user.nama;
          }
        } catch {}
      } else if (adminSessionStr) {
        if (userNameEl) userNameEl.textContent = "Aparatur Desa";
      }

      lockedEl?.classList.add('hidden');
      unlockedEl?.classList.remove('hidden');
    } else {
      // General public -> show privacy lock gate
      unlockedEl?.classList.add('hidden');
      lockedEl?.classList.remove('hidden');
    }
  });
</script>
