		<!-- Client Side Script for Real Auth & Drawer -->
		<script>
			import { supabase } from '../lib/supabase';

			document.addEventListener('DOMContentLoaded', async () => {
				// 1. Mobile Drawer Toggle Logic
				const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
				const closeBtn = document.getElementById('mobile-drawer-close-btn');
				const backdrop = document.getElementById('mobile-drawer-backdrop');
				const sidebar = document.getElementById('admin-sidebar');

				function openDrawer() {
					if (!sidebar || !backdrop) return;
					sidebar.classList.remove('-translate-x-full');
					sidebar.classList.add('translate-x-0');
					backdrop.classList.remove('hidden');
					setTimeout(() => backdrop.classList.add('opacity-100'), 10);
				}

				function closeDrawer() {
					if (!sidebar || !backdrop) return;
					sidebar.classList.add('-translate-x-full');
					sidebar.classList.remove('translate-x-0');
					backdrop.classList.remove('opacity-100');
					setTimeout(() => backdrop.classList.add('hidden'), 200);
				}

				toggleBtn?.addEventListener('click', openDrawer);
				closeBtn?.addEventListener('click', closeDrawer);
				backdrop?.addEventListener('click', closeDrawer);

				// Close drawer on ESC key
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') closeDrawer();
				});

				// 2. Strict Auth Guard: Check real user session
				const { data: { session } } = await supabase.auth.getSession();
				const localAdminSessionStr = localStorage.getItem('admin_session');

				if (!session && !localAdminSessionStr) {
					// Not logged in -> Kick to /admin/login immediately!
					window.location.href = '/admin/login';
					return;
				}

				if (session && session.user) {
					const email = session.user.email || '';
					const name = session.user.user_metadata?.name || email.split('@')[0] || 'Admin';
					const initial = name.charAt(0).toUpperCase();

					const nameEl = document.getElementById('user-name-display');
					const roleEl = document.getElementById('user-role-display');
					const initialEl = document.getElementById('user-initial-display');

					if (nameEl) nameEl.textContent = name;
					if (roleEl) roleEl.textContent = email;
					if (initialEl) initialEl.textContent = initial;
				} else if (localAdminSessionStr) {
					try {
						const adminObj = JSON.parse(localAdminSessionStr);
						const nameEl = document.getElementById('user-name-display');
						const roleEl = document.getElementById('user-role-display');
						const initialEl = document.getElementById('user-initial-display');

						if (nameEl) nameEl.textContent = adminObj.name || 'Administrator';
						if (roleEl) roleEl.textContent = adminObj.role || 'Aparatur Desa';
						if (initialEl) initialEl.textContent = (adminObj.name || 'A').charAt(0).toUpperCase();
					} catch {}
				}

				// 3. Logout Handler
				const logoutBtn = document.getElementById('logout-btn');
				if (logoutBtn) {
					logoutBtn.addEventListener('click', async (e) => {
						e.preventDefault();
						if (confirm('Apakah Anda yakin ingin keluar dari panel admin?')) {
							localStorage.removeItem('admin_session');
							try {
								await supabase.auth.signOut();
							} catch {}
							window.location.href = '/admin/login';
						}
					});
				}
			});
		</script>
	</body>
</html>

