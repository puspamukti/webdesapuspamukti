---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/admin') return pathname === '/admin' || pathname === '/admin/';
  return pathname.startsWith(path);
};
---
<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/webp" href="/logodesa.webp" />
		<title>{title} | Panel Admin Desa Puspamukti</title>

		<!-- Immediate Zero-Delay Admin Auth Gate (Synchronous) -->
		<script is:inline>
			(function() {
				try {
					var adminSession = localStorage.getItem('admin_session');
					if (!adminSession) {
						// Clean any stale auth tokens completely
						for (var i = localStorage.length - 1; i >= 0; i--) {
							var k = localStorage.key(i);
							if (k && (k.indexOf('auth-token') !== -1 || k.indexOf('supabase') !== -1)) {
								localStorage.removeItem(k);
							}
						}
						window.location.replace('/admin/login');
					}
				} catch (e) {
					window.location.replace('/admin/login');
				}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-muted/20 font-sans antialiased text-foreground flex overflow-hidden">
		
		<!-- Mobile Drawer Backdrop Overlay -->
		<div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-40 hidden md:hidden transition-opacity duration-200 opacity-0"></div>

		<!-- Sidebar (Desktop & Mobile Drawer) -->
		<aside id="admin-sidebar" class="fixed md:static inset-y-0 left-0 -translate-x-full md:translate-x-0 flex flex-col w-64 bg-card border-r shadow-lg md:shadow-sm z-50 h-screen transition-transform duration-200 ease-in-out shrink-0">
