---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';

interface Props {
	title: string;
}

// Fetch latest published news for the ticker
const { data: latestBerita } = await supabase
  .from('berita')
  .select('*')
  .eq('status', 'Terbit')
  .order('created_at', { ascending: false })
  .limit(5);

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/logodesa.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Desa Puspamukti</title>
		
		<!-- Performance preconnects & DNS prefetch -->
		<link rel="preconnect" href="https://icghbytqyhjfjvkxvlwt.supabase.co" />
		<link rel="preconnect" href="https://unpkg.com" crossorigin />
		<link rel="dns-prefetch" href="https://mt1.google.com" />
		
		<!-- SEO best practices -->
		<meta name="description" content="Website Resmi Portal & Admin Desa Puspamukti, Kec. Cigalontang, Kab. Tasikmalaya. Menyajikan informasi layanan, berita, dan data desa secara digital." />
		<meta property="og:title" content={title + " | Desa Puspamukti"} />
		<meta property="og:description" content="Portal resmi Desa Puspamukti menyajikan layanan publik, berita, dan data statistik desa." />
		<meta property="og:type" content="website" />
		<!-- SEO enhancements -->
		<meta name="keywords" content="Desa Puspamukti, KKN, layanan publik, berita desa, data statistik, portal desa" />
		<link rel="canonical" href={`https://desapuspamukti.id${Astro.url.pathname}`} />
	</head>
	<body class="min-h-screen bg-background font-sans antialiased text-foreground flex flex-col">
		<!-- Running Text / Ticker -->
		<div class="pause-on-hover bg-white text-foreground py-2.5 overflow-hidden flex border-b">
			<div class="animate-marquee flex shrink-0 min-w-full items-center justify-around">
				{latestBerita && latestBerita.length > 0 ? (
					latestBerita.map((item) => (
						<a href="/informasi/media" class="inline-flex items-center gap-2 mx-6 hover:text-primary transition-colors cursor-pointer group/item" key={item.id}>
							<div class="w-6 h-6 rounded-full overflow-hidden bg-muted border flex-shrink-0 group-hover/item:border-primary transition-colors">
								<img src="/logodesa_thumb.webp" width="24" height="24" loading="lazy" decoding="async" class="w-full h-full object-cover" alt={item.judul} />
							</div>
							<span class="text-sm font-medium">{item.judul}</span>
						</a>
					))
				) : (
					<a href="/informasi/media" class="inline-flex items-center gap-2 mx-6 hover:text-primary transition-colors cursor-pointer group/item">
						<div class="w-6 h-6 rounded-full overflow-hidden bg-muted border flex-shrink-0 group-hover/item:border-primary transition-colors">
							<img src="/logodesa_thumb.webp" width="24" height="24" loading="lazy" decoding="async" class="w-full h-full object-cover" alt="News thumb" />
						</div>
						<span class="text-sm font-medium">Berita terbaru belum tersedia</span>
					</a>
				)}
			</div>
			<!-- duplicate for seamless loop -->
			<div class="animate-marquee flex shrink-0 min-w-full items-center justify-around" aria-hidden="true">
				{latestBerita && latestBerita.length > 0 ? (
					latestBerita.map((item) => (
						<a href="/informasi/media" class="inline-flex items-center gap-2 mx-6 hover:text-primary transition-colors cursor-pointer group/item" key={item.id}>
							<div class="w-6 h-6 rounded-full overflow-hidden bg-muted border flex-shrink-0 group-hover/item:border-primary transition-colors">
								<img src="/logodesa_thumb.webp" width="24" height="24" loading="lazy" decoding="async" class="w-full h-full object-cover" alt={item.judul} />
							</div>
							<span class="text-sm font-medium">{item.judul}</span>
						</a>
					))
				) : null}
			</div>
		</div>

		<!-- Logo Header -->
		<div class="w-full bg-white flex justify-center py-4 md:py-6 z-10 relative">
			<div class="container mx-auto px-4 max-w-screen-xl flex justify-center">
				<img 
					src="/WFW.webp" 
					alt="Logo Desa Puspamukti" 
					width="800" 
					height="180" 
					fetchpriority="high" 
					class="h-20 md:h-28 w-auto object-contain" 
				/>
			</div>
		</div>

		<Navbar />
		
		<div class="flex-grow">
			<slot />
		</div>
		
		<Footer />
		
		<!-- Floating WhatsApp Button -->
		<a 
			href="https://wa.me/6280000000000" 
			target="_blank" 
			rel="noopener noreferrer" 
			class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#128C7E] text-white p-3.5 rounded-full shadow-xl transition-all hover:scale-110 flex items-center justify-center group"
			aria-label="Hubungi WhatsApp Desa"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
			<!-- Tooltip -->
			<span class="absolute right-full top-1/2 -translate-y-1/2 mr-4 bg-black/80 backdrop-blur-sm text-white text-xs font-medium px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
				Layanan Desa
			</span>
		</a>
	</body>
</html>

<style is:global>
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }
  .pause-on-hover:hover .animate-marquee {
    animation-play-state: paused !important;
  }
</style>
